<div class="container">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><%= @video.title %> - 受講状況分析</h1>
        <div>
          <%= link_to "管理者追加", video_management_add_manager_path(video_id: @video), class: "btn btn-outline-primary" %>
          <%= link_to "動画編集", edit_video_path(@video), class: "btn btn-primary" %>
          <%= link_to "戻る", root_path, class: "btn btn-secondary" %>
        </div>
      </div>

      <!-- CSVエクスポートボタン -->
      <div class="card mb-4">
        <div class="card-body">
          <h5 class="card-title">📊 データエクスポート</h5>
          <p class="text-muted mb-2">分析データをCSV形式でダウンロードできます。Excel で開いて自由に分析できます。</p>

          <p class="fw-semibold mb-1 mt-3 small text-muted">全セッション一括エクスポート</p>
          <div class="row g-2 mb-3">
            <div class="col-md-4">
              <%= link_to video_management_export_sessions_path(video_id: @video, format: :csv), class: "btn btn-primary w-100", data: { turbo: false } do %>
                <i class="bi bi-file-earmark-spreadsheet"></i> セッション一覧
              <% end %>
              <small class="text-muted d-block mt-1">全セッションの概要（1行1セッション）一時停止・スキップ回数・スコアなど</small>
            </div>
            <div class="col-md-4">
              <%= link_to video_management_export_events_path(video_id: @video, format: :csv), class: "btn btn-primary w-100", data: { turbo: false } do %>
                <i class="bi bi-file-earmark-spreadsheet"></i> 全イベントログ
              <% end %>
              <small class="text-muted d-block mt-1">全セッションの操作ログ（1行1イベント）ピボットテーブル分析向け</small>
            </div>
            <div class="col-md-4">
              <%= link_to video_management_export_pauses_path(video_id: @video, format: :csv), class: "btn btn-primary w-100", data: { turbo: false } do %>
                <i class="bi bi-file-earmark-spreadsheet"></i> 一時停止分析
              <% end %>
              <small class="text-muted d-block mt-1">停止位置・停止時間を1行1停止で出力。書き取り時間分析向け</small>
            </div>
          </div>

          <p class="fw-semibold mb-1 mt-3 small text-muted">統計サマリー</p>
          <div class="row g-2">
            <div class="col-md-6">
              <%= link_to video_management_export_summary_path(video_id: @video, format: :csv), class: "btn btn-success w-100", data: { turbo: false } do %>
                <i class="bi bi-file-earmark-spreadsheet"></i> 全体サマリー
              <% end %>
              <small class="text-muted d-block mt-1">動画全体の集計統計</small>
            </div>
            <div class="col-md-6">
              <%= link_to video_management_export_questions_path(video_id: @video, format: :csv), class: "btn btn-success w-100", data: { turbo: false } do %>
                <i class="bi bi-file-earmark-spreadsheet"></i> 問題別統計
              <% end %>
              <small class="text-muted d-block mt-1">各問題の回答統計</small>
            </div>
          </div>
        </div>
      </div>

      <!-- 全体統計 -->
      <div class="row mb-4">
        <div class="col-md-3">
          <div class="card text-center">
            <div class="card-body">
              <h5 class="card-title">総回答数</h5>
              <h2 class="text-primary"><%= @total_responses %></h2>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center">
            <div class="card-body">
              <h5 class="card-title">受講者数</h5>
              <h2 class="text-info"><%= @unique_users %></h2>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center">
            <div class="card-body">
              <h5 class="card-title">正答数</h5>
              <h2 class="text-success"><%= @correct_responses %></h2>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center">
            <div class="card-body">
              <h5 class="card-title">正答率</h5>
              <h2 class="text-warning"><%= @accuracy_rate %>%</h2>
            </div>
          </div>
        </div>
      </div>

      <!-- 問題別統計 -->
      <div class="card mb-4">
        <div class="card-header">
          <h3>問題別統計</h3>
        </div>
        <div class="card-body">
          <% if @question_stats.any? %>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>問題</th>
                    <th>タイプ</th>
                    <th>時間位置</th>
                    <th>回答数</th>
                    <th>正答数</th>
                    <th>正答率</th>
                    <th>平均回答時間</th>
                  </tr>
                </thead>
                <tbody>
                  <% @question_stats.each do |stat| %>
                    <tr>
                      <td><%= truncate(stat[:question].content, length: 50) %></td>
                      <td>
                        <span class="badge <%= question_type_badge_class(stat[:question].question_type) %>">
                          <%= question_type_display(stat[:question].question_type) %>
                        </span>
                      </td>
                      <td><%= format_time_position(stat[:question].time_position) %></td>
                      <td><%= stat[:total_responses] %></td>
                      <td><%= stat[:correct_responses] %></td>
                      <td>
                        <% if stat[:accuracy_rate] >= 80 %>
                          <span class="text-success"><%= stat[:accuracy_rate] %>%</span>
                        <% elsif stat[:accuracy_rate] >= 60 %>
                          <span class="text-warning"><%= stat[:accuracy_rate] %>%</span>
                        <% else %>
                          <span class="text-danger"><%= stat[:accuracy_rate] %>%</span>
                        <% end %>
                      </td>
                      <td><%= stat[:average_response_time] %>秒</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted">この動画には問題がありません。</p>
          <% end %>
        </div>
      </div>

      <!-- タイムラインデータ可視化グラフ -->
      <% if @learning_sessions && @learning_sessions.any? %>
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="mb-0">学習タイムライン分析グラフ</h3>
            <small class="text-muted">💡 マウスホイールでズーム、ドラッグで移動、ダブルクリックでリセット</small>
          </div>
          <div class="card-body">
            <!-- グラフナビゲーション -->
            <ul class="nav nav-tabs mb-3" id="chartTabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="score-timeline-tab" data-bs-toggle="tab" data-bs-target="#score-timeline" type="button">
                  集中スコア推移
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="hourly-activity-tab" data-bs-toggle="tab" data-bs-target="#hourly-activity" type="button">
                  時間帯別活動
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="user-scores-tab" data-bs-toggle="tab" data-bs-target="#user-scores" type="button">
                  ユーザー別スコア
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="video-density-tab" data-bs-toggle="tab" data-bs-target="#video-density" type="button">
                  動画イベント密度
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="video-operations-tab" data-bs-toggle="tab" data-bs-target="#video-operations" type="button">
                  動画操作マップ
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="user-operations-tab" data-bs-toggle="tab" data-bs-target="#user-operations" type="button">
                  ユーザー別操作
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="user-classification-tab" data-bs-toggle="tab" data-bs-target="#user-classification" type="button">
                  ユーザー分類分析
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="pause-heatmap-tab" data-bs-toggle="tab" data-bs-target="#pause-heatmap" type="button">
                  一時停止ヒートマップ
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="skip-heatmap-tab" data-bs-toggle="tab" data-bs-target="#skip-heatmap" type="button">
                  スキップ分析
                </button>
              </li>
            </ul>

            <!-- グラフコンテンツ -->
            <div class="tab-content" id="chartTabsContent">
              <!-- 1. 集中スコア推移グラフ -->
              <div class="tab-pane fade show active" id="score-timeline" role="tabpanel">
                <div class="mb-3">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <button class="btn btn-sm btn-outline-info" type="button" data-bs-toggle="collapse" data-bs-target="#scoreTimelineTogglesCollapse" aria-expanded="true">
                      <i class="bi bi-chevron-down"></i> 表示するセッション
                    </button>
                    <div>
                      <button class="btn btn-sm btn-outline-primary" onclick="toggleAllSessions('scoreTimeline', true)">すべて表示</button>
                      <button class="btn btn-sm btn-outline-secondary" onclick="toggleAllSessions('scoreTimeline', false)">すべて非表示</button>
                    </div>
                  </div>
                  <div class="collapse show" id="scoreTimelineTogglesCollapse">
                    <div id="scoreTimelineSessionToggles" class="row"></div>
                  </div>
                  
                  <!-- ユーザーごとに色分けするトグル -->
                  <div class="mt-3 mb-3">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="colorByUserToggle" onchange="toggleColorByUser()">
                      <label class="form-check-label" for="colorByUserToggle">
                        <strong>ユーザーごとに色分け</strong>
                      </label>
                      <small class="text-muted d-block ms-4">セッションの線の色をユーザーで変更します（オフ時はスコア基準）</small>
                    </div>
                  </div>
                  
                  <!-- マーカーを非表示にするトグル -->
                  <div class="mt-3 mb-3">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="hideMarkersToggle" onchange="toggleMarkerVisibility()">
                      <label class="form-check-label" for="hideMarkersToggle">
                        <strong>マーカーを非表示にする</strong>
                      </label>
                      <small class="text-muted d-block ms-4">動画操作（一時停止、スキップ）と反応速度（回答）のマーカーを非表示にします</small>
                    </div>
                  </div>
                  
                  <!-- 動画時刻0のデータフィルター -->
                  <div class="mt-3 mb-3">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="hideVideoTime0" onchange="toggleVideoTime0Filter()">
                      <label class="form-check-label" for="hideVideoTime0">
                        動画時刻0秒のデータを非表示にする
                      </label>
                      <small class="text-muted d-block ms-4">動画が再生される前のデータポイントを除外します</small>
                    </div>
                  </div>

                  <!-- 横軸（経過時間）の最大値スライダー -->
                  <div class="mt-3 mb-3 p-3 border rounded bg-light">
                    <div class="fw-semibold small mb-2">横軸の最大表示時間</div>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                      <input type="range" class="form-range" id="xAxisMaxSlider"
                             min="1" max="300" value="120" step="1" style="flex:1; min-width:120px;"
                             oninput="updateXAxisSliderDisplay()">
                      <span id="xAxisMaxDisplay" class="fw-semibold text-nowrap" style="min-width:4.5rem;">120 分</span>
                      <button type="button" class="btn btn-sm btn-primary" onclick="applyXAxisMax()">設定</button>
                      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetXAxisMax()">リセット</button>
                    </div>
                    <div class="text-muted mt-1" style="font-size:0.76rem;">
                      設定した時間より長い視聴履歴は右側が見切れます。リセットで全データに合わせた自動スケールに戻ります。
                    </div>
                  </div>
                </div>
                <div class="chart-container" style="position: relative; height: 800px;">
                  <canvas id="scoreTimelineChart"></canvas>
                  <!-- セッション選択ポップアップ -->
                  <div id="scoreTimelinePopup" style="display:none; position:absolute; z-index:200;
                       background:#fff; border:1px solid #dee2e6; border-radius:8px;
                       padding:10px 12px; box-shadow:0 4px 16px rgba(0,0,0,0.15); min-width:220px;">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                      <strong id="stPopupLabel" style="font-size:0.82rem; word-break:break-all;"></strong>
                      <button type="button"
                              onclick="document.getElementById('scoreTimelinePopup').style.display='none'"
                              class="btn-close ms-2" style="font-size:0.65rem; flex-shrink:0;"></button>
                    </div>
                    <div id="stPopupInfo" class="text-muted mb-2" style="font-size:0.76rem;"></div>
                    <a id="stPopupEditLink" href="#" class="btn btn-warning btn-sm w-100 mb-1">
                      ✏️ イベント編集画面へ
                    </a>
                    <button id="stPopupDeleteBtn" type="button" class="btn btn-outline-danger btn-sm w-100">
                      🗑️ このセッションを削除
                    </button>
                  </div>
                </div>
                <p class="text-muted mt-2 text-center">
                  <small>各セッションの集中スコアの時間的推移を表示します。線をクリックするとイベント編集画面へ移動できます。</small>
                </p>
              </div>

              <!-- 2. 時間帯別活動量グラフ -->
              <div class="tab-pane fade" id="hourly-activity" role="tabpanel">
                <div class="chart-container" style="position: relative; height: 400px;">
                  <canvas id="hourlyActivityChart"></canvas>
                </div>
                <p class="text-muted mt-2 text-center">
                  <small>1日の中でどの時間帯に学習活動が活発かを表示します。</small>
                </p>
              </div>
              
              <script>
                // 時間帯別活動タブクリック時に再度グラフを初期化
                document.getElementById('hourly-activity-tab')?.addEventListener('shown.bs.tab', function() {
                  console.log('[時間帯別活動タブ] クリック検出');
                  if (chartInstances.hourlyActivity) {
                    chartInstances.hourlyActivity.destroy();
                    chartInstances.hourlyActivity = null;
                  }
                  
                  // 再度グラフを初期化
                  if (chartsData && chartsData.hourly_activity_data) {
                    const ctx = document.getElementById('hourlyActivityChart');
                    const hourlyData = chartsData.hourly_activity_data;
                    
                    chartInstances.hourlyActivity = new Chart(ctx, {
                      type: 'bar',
                      data: {
                        labels: hourlyData.labels.map(h => h + '時'),
                        datasets: [{
                          label: 'イベント数',
                          data: hourlyData.values,
                          backgroundColor: 'rgba(54, 162, 235, 0.8)',
                          borderColor: 'rgba(54, 162, 235, 1)',
                          borderWidth: 1
                        }]
                      },
                      options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                          legend: {
                            display: true,
                            position: 'top'
                          }
                        },
                        scales: {
                          x: {
                            title: {
                              display: true,
                              text: '時間帯'
                            }
                          },
                          y: {
                            title: {
                              display: true,
                              text: 'イベント数'
                            },
                            beginAtZero: true,
                            ticks: {
                              stepSize: 1
                            }
                          }
                        }
                      }
                    });
                    console.log('[時間帯別活動タブ] グラフ再初期化完了');
                  }
                });
              </script>

              <!-- 4. ユーザー別平均スコアグラフ -->
              <div class="tab-pane fade" id="user-scores" role="tabpanel">
                <div class="chart-container" style="position: relative; height: 400px;">
                  <canvas id="userScoresChart"></canvas>
                </div>
                <p class="text-muted mt-2 text-center">
                  <small>各ユーザーの平均集中スコアを比較表示します。</small>
                </p>
              </div>
              
              <script>
                // ユーザースコアタブクリック時に再度グラフを初期化
                document.getElementById('user-scores-tab')?.addEventListener('shown.bs.tab', function() {
                  console.log('[ユーザースコアタブ] クリック検出');
                  if (chartInstances.userScores) {
                    chartInstances.userScores.destroy();
                    chartInstances.userScores = null;
                  }
                  
                  // 再度グラフを初期化
                  if (chartsData && chartsData.user_score_data) {
                    const ctx = document.getElementById('userScoresChart');
                    const scoreData = chartsData.user_score_data;
                    
                    chartInstances.userScores = new Chart(ctx, {
                      type: 'bar',
                      data: {
                        labels: scoreData.labels,
                        datasets: [{
                          label: '平均スコア',
                          data: scoreData.values,
                          backgroundColor: 'rgba(255, 159, 64, 0.8)',
                          borderColor: 'rgba(255, 159, 64, 1)',
                          borderWidth: 1
                        }]
                      },
                      options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                          legend: {
                            display: true,
                            position: 'top'
                          }
                        },
                        scales: {
                          x: {
                            title: {
                              display: true,
                              text: 'ユーザー'
                            }
                          },
                          y: {
                            title: {
                              display: true,
                              text: '平均スコア'
                            },
                            beginAtZero: true,
                            max: 100
                          }
                        }
                      }
                    });
                    console.log('[ユーザースコアタブ] グラフ再初期化完了');
                  }
                });
              </script>

              <!-- 5. 動画時間別イベント密度グラフ -->
              <div class="tab-pane fade" id="video-density" role="tabpanel">
                <div class="chart-container" style="position: relative; height: 400px;">
                  <canvas id="videoDensityChart"></canvas>
                </div>
                <p class="text-muted mt-2 text-center">
                  <small>動画のどの部分で学習活動が活発かを30秒単位で表示します。</small>
                </p>
              </div>
              
              <script>
                // 動画密度チャートタブクリック時に再度グラフを初期化
                document.getElementById('video-density-tab')?.addEventListener('shown.bs.tab', function() {
                  console.log('[動画密度タブ] クリック検出');
                  if (chartInstances.videoDensity) {
                    chartInstances.videoDensity.destroy();
                    chartInstances.videoDensity = null;
                  }
                  
                  // 再度グラフを初期化
                  if (chartsData && chartsData.video_time_density_data) {
                    const ctx = document.getElementById('videoDensityChart');
                    const densityData = chartsData.video_time_density_data;
                    
                    chartInstances.videoDensity = new Chart(ctx, {
                      type: 'line',
                      data: {
                        labels: densityData.labels,
                        datasets: [{
                          label: 'イベント数',
                          data: densityData.values,
                          backgroundColor: 'rgba(75, 192, 75, 0.2)',
                          borderColor: 'rgba(75, 192, 75, 1)',
                          borderWidth: 2,
                          tension: 0.1,
                          fill: true
                        }]
                      },
                      options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                          legend: {
                            display: true,
                            position: 'top'
                          }
                        },
                        scales: {
                          x: {
                            title: {
                              display: true,
                              text: '動画時刻（秒）'
                            }
                          },
                          y: {
                            title: {
                              display: true,
                              text: 'イベント集約度'
                            },
                            beginAtZero: true
                          }
                        }
                      }
                    });
                    console.log('[動画密度タブ] グラフ再初期化完了');
                  }
                });
              </script>

              <!-- 6. 動画操作マップ（全体） -->
              <div class="tab-pane fade" id="video-operations" role="tabpanel">
                <div class="mb-3">
                  <label for="operationsMapBins" class="form-label">横軸の分割数: <span id="operationsMapBinsValue">20</span></label>
                  <div class="d-flex align-items-center gap-2">
                    <input type="range" class="form-range" id="operationsMapBins" min="5" max="100" value="20" step="5">
                    <button class="btn btn-sm btn-outline-primary" onclick="updateOperationsMapBins()">更新</button>
                  </div>
                  <small class="text-muted">分割数を調整して、動画を何等分にして集計するかを変更できます。</small>
                </div>
                <div class="chart-container" style="position: relative; height: 400px;">
                  <canvas id="videoOperationsChart"></canvas>
                </div>
                <p class="text-muted mt-2 text-center">
                  <small>動画内のどの時間で一時停止やスキップ（シーク）が行われたかを表示します。棒が高いほど操作が多い箇所です。</small>
                </p>
              </div>

              <!-- 7. ユーザー別動画操作 -->
              <div class="tab-pane fade" id="user-operations" role="tabpanel">
                <div class="mb-3">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <button class="btn btn-sm btn-outline-info" type="button" data-bs-toggle="collapse" data-bs-target="#userOperationsTogglesCollapse" aria-expanded="true">
                      <i class="bi bi-chevron-down"></i> 表示するセッション
                    </button>
                    <div>
                      <button class="btn btn-sm btn-outline-primary" onclick="toggleAllSessions('userOperations', true)">すべて表示</button>
                      <button class="btn btn-sm btn-outline-secondary" onclick="toggleAllSessions('userOperations', false)">すべて非表示</button>
                    </div>
                  </div>
                  <div class="collapse show" id="userOperationsTogglesCollapse">
                    <div id="userOperationsSessionToggles" class="row"></div>
                  </div>
                </div>
                <div class="chart-container" style="position: relative; height: 400px;">
                  <canvas id="userOperationsChart"></canvas>
                </div>
                <p class="text-muted mt-2 text-center">
                  <small>各ユーザーが動画のどの時間で操作を行ったかをセッション別に表示します。</small>
                </p>
              </div>

              <!-- 8. ユーザー分類分析 -->
              <div class="tab-pane fade" id="user-classification" role="tabpanel">
                <div class="mb-3">
                  <div class="alert alert-info d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div><strong>使い方：</strong>グラフのセッションラインをクリックして分類します。ダブルクリックでズームリセット。</div>
                    <div class="d-flex gap-2 flex-wrap">
                      <button class="btn btn-sm btn-outline-primary" id="refreshUcChartBtn" onclick="refreshUcChart()">↺ グラフを更新</button>
                      <button class="btn btn-sm btn-warning" onclick="resetUserClassification()">ビジュアル分類をリセット</button>
                      <button class="btn btn-sm btn-outline-danger" onclick="resetAllDbGroups()">DBグループ分類をリセット</button>
                    </div>
                  </div>

                  <!-- 分類結果CSVエクスポート -->
                  <div class="mb-3 p-3 border rounded d-flex align-items-center justify-content-between flex-wrap gap-3" style="background:#f0fff4; border-color:#6fcf97 !important;">
                    <div>
                      <span class="fw-semibold">📥 分類結果 CSV エクスポート</span>
                      <span class="text-muted small ms-2">ユーザー名・グループ・開始/終了時刻・学習時間・問題回答結果</span>
                    </div>
                    <div class="d-flex gap-2">
                      <%= link_to video_management_export_classification_path(video_id: @video, email_order: "asc", format: :csv),
                            class: "btn btn-success", data: { turbo: false } do %>
                        ↑ メール昇順 (A→Z)
                      <% end %>
                      <%= link_to video_management_export_classification_path(video_id: @video, email_order: "desc", format: :csv),
                            class: "btn btn-success", data: { turbo: false } do %>
                        ↓ メール降順 (Z→A)
                      <% end %>
                    </div>
                  </div>

                  <!-- モード切り替え -->
                  <div class="mb-3 p-2 bg-light border rounded d-flex align-items-center gap-4 flex-wrap">
                    <strong class="text-muted small">クリック操作:</strong>
                    <div class="form-check form-check-inline mb-0">
                      <input class="form-check-input" type="radio" name="classificationMode"
                             id="modeVisual" value="visual" checked
                             onchange="switchClassificationMode('visual')">
                      <label class="form-check-label" for="modeVisual">ビジュアル分類 (A/B/C/D)</label>
                    </div>
                    <div class="form-check form-check-inline mb-0">
                      <input class="form-check-input" type="radio" name="classificationMode"
                             id="modeDb" value="db"
                             onchange="switchClassificationMode('db')">
                      <label class="form-check-label" for="modeDb">
                        <span class="badge bg-success me-1">DB保存</span>セッショングループ分類
                      </label>
                    </div>
                  </div>

                  <!-- ビジュアル分類コントロール (A/B/C/D) -->
                  <div id="visual-mode-controls">
                    <div class="mb-3">
                      <label><strong>分類対象グループ:</strong></label>
                      <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="classificationGroup" id="groupA" value="groupA" checked>
                        <label class="btn btn-outline-primary" for="groupA">グループA</label>

                        <input type="radio" class="btn-check" name="classificationGroup" id="groupB" value="groupB">
                        <label class="btn btn-outline-success" for="groupB">グループB</label>

                        <input type="radio" class="btn-check" name="classificationGroup" id="groupC" value="groupC">
                        <label class="btn btn-outline-warning" for="groupC">グループC</label>

                        <input type="radio" class="btn-check" name="classificationGroup" id="groupD" value="groupD">
                        <label class="btn btn-outline-danger" for="groupD">グループD</label>
                      </div>
                    </div>
                  </div>

                  <!-- DBグループ分類コントロール -->
                  <div id="db-mode-controls" style="display:none;">
                    <div class="mb-2">
                      <label class="fw-bold mb-1">セッショングループ <small class="text-muted fw-normal">（クリックで即DB保存・同じグループ再クリックで解除）</small></label>
                      <div class="d-flex flex-wrap gap-2">
                        <input type="radio" class="btn-check" name="dbClassificationGroup" id="dbGroupNormal" value="normal" checked>
                        <label class="btn btn-sm btn-outline-primary" for="dbGroupNormal">等倍</label>

                        <input type="radio" class="btn-check" name="dbClassificationGroup" id="dbGroupFast" value="fast_speed">
                        <label class="btn btn-sm" for="dbGroupFast" style="border:1px solid #8B5CF6;color:#8B5CF6;">倍速</label>

                        <input type="radio" class="btn-check" name="dbClassificationGroup" id="dbGroupSkip" value="skip_heavy">
                        <label class="btn btn-sm btn-outline-warning" for="dbGroupSkip">飛ばしが多い</label>

                        <input type="radio" class="btn-check" name="dbClassificationGroup" id="dbGroupFastSkip" value="fast_and_skip">
                        <label class="btn btn-sm btn-outline-danger" for="dbGroupFastSkip">倍速と飛ばしの混在</label>

                        <input type="radio" class="btn-check" name="dbClassificationGroup" id="dbGroupShort" value="too_short">
                        <label class="btn btn-sm" for="dbGroupShort" style="border:1px solid #EC4899;color:#EC4899;">異様に視聴が短い</label>

                        <input type="radio" class="btn-check" name="dbClassificationGroup" id="dbGroupLong" value="too_long">
                        <label class="btn btn-sm" for="dbGroupLong" style="border:1px solid #14B8A6;color:#14B8A6;">視聴が超長い（その他）</label>

                        <input type="radio" class="btn-check" name="dbClassificationGroup" id="dbGroupNone" value="">
                        <label class="btn btn-sm btn-outline-secondary" for="dbGroupNone">× 解除</label>
                      </div>
                    </div>
                    <div id="db-classification-stats" class="mb-2 d-flex flex-wrap gap-2"></div>
                  </div>

                  <!-- マーカー非表示トグル -->
                  <div class="mt-3 mb-3">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="hideMarkersClassificationToggle" onchange="toggleMarkerVisibilityClassification()">
                      <label class="form-check-label" for="hideMarkersClassificationToggle">
                        <strong>マーカーを非表示にして線だけ表示</strong>
                      </label>
                      <small class="text-muted d-block ms-4">セッションラインのマーカー（ポイント）を非表示にエシステムを簡潔にします</small>
                    </div>
                  </div>

                  <!-- ユーザー数ベースでカウント -->
                  <div class="mt-3 mb-3">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="countUniqueUsersToggle" onchange="window.classificationMode === 'db' ? updateDbFullStats() : updateClassificationStats()">
                      <label class="form-check-label" for="countUniqueUsersToggle">
                        <strong>ユーザー数でカウント（セッション数ではなく）</strong>
                      </label>
                      <small class="text-muted d-block ms-4">同じユーザーが複数セッションある場合、1人としてカウントします</small>
                    </div>
                  </div>

                  <!-- K-means 自動分類 -->
                  <div class="border rounded p-3 mb-3" style="background:#f8fafc;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                      <span class="fw-semibold">🤖 自動分類（K-meansクラスタリング）</span>
                      <div class="d-flex align-items-center gap-2">
                        <label class="small mb-0 text-muted">クラスター数 k =</label>
                        <input type="number" id="kmeansK" min="2" max="8" value="6"
                               class="form-control form-control-sm" style="width:60px;">
                        <button class="btn btn-sm btn-outline-primary" onclick="runKmeans()">実行</button>
                      </div>
                    </div>
                    <small class="text-muted d-block mb-2">
                      有効再生速度・スキップカバレッジ・期間比・スキップ率の4軸でセッションを自動グループ分けします。
                      実行後にチャートでプレビューし、グループ名を確認してから保存できます。
                    </small>
                    <details class="mb-2">
                      <summary class="small text-primary" style="cursor:pointer;">📐 使用する指標の定義と計算方法</summary>
                      <div class="mt-2 ps-2 border-start border-2" style="font-size:0.8rem; line-height:1.7;">

                        <p class="text-muted mb-2">
                          各指標はセッション終了時点の記録値（<code>last_video_time</code>・<code>last_session_elapsed</code>）と、
                          再生中に記録されたイベントログから計算します。<br>
                          動画の総時間は、動画編集画面で「動画の長さ」を設定している場合はその値を使用します。
                          未設定の場合は<strong>全セッションの <code>last_video_time</code> 上位10%の平均値</strong>で推定します
                          （最も遠くまで視聴した受講者の平均到達点を動画長とみなします）。
                          正確な計算のために、動画編集画面から長さを設定することを推奨します。
                        </p>

                        <dl class="mb-0">
                          <dt>有効再生速度（effective_speed）</dt>
                          <dd class="text-muted mb-2">
                            <code>last_video_time ÷ last_session_elapsed</code><br>
                            <strong>使ったデータ:</strong> セッション最後の動画再生位置（秒）÷ セッション開始からの経過時間（秒）。<br>
                            1.0 = 等倍視聴、1.5 = 1.5倍ペースで進んだ（高速再生・飛ばしが多い）、0.5 = 一時停止や繰り返しが多い。
                          </dd>

                          <dt>スキップカバレッジ（skip_coverage）</dt>
                          <dd class="text-muted mb-2">
                            <code>前進スキップ量の合計 ÷ 動画総時間（推定）</code><br>
                            <strong>使ったデータ:</strong> イベントログの <code>video_skip</code> / <code>video_seek</code> イベントのうち、
                            移動先（to）が移動元（from）より後方のもの（前進）について <code>to − from</code> を合計し、推定動画長で割る。<br>
                            0.1 なら動画全体の10%をスキップした。
                          </dd>

                          <dt>期間比（duration_ratio）</dt>
                          <dd class="text-muted mb-2">
                            <code>last_session_elapsed ÷ 動画総時間（推定）</code><br>
                            <strong>使ったデータ:</strong> セッション経過時間 ÷ 推定動画長。<br>
                            1.0 = 動画と同じ長さをかけて視聴、0.1 = 動画の1/10の時間で終了（非常に短い視聴）。
                          </dd>

                          <dt>再生速度（playing_speed）</dt>
                          <dd class="text-muted mb-2">
                            <code>一時停止中・シークジャンプを除いた Δvideo_time の合計 ÷ 実再生時間の合計</code><br>
                            <strong>使ったデータ:</strong> <code>video_play</code>→<code>video_pause</code> の各区間を積み上げ。シーク時は <code>additional_data["from"]</code> を使ってジャンプ前後でセグメントを分割し、ジャンプ量は除外する。<br>
                            1.5 なら「実際に再生していた時間」に対して動画が1.5倍速で進んだことを意味し、有効再生速度（一時停止込み）と比較することで一時停止の多さを推測できる。<br>
                            <em>play/pause イベントが記録されていないセッションは有効再生速度と同値にフォールバック。</em>
                          </dd>
                          <dt>スキップ率（skip_rate）</dt>
                          <dd class="text-muted mb-0">
                            <code>前進スキップ回数 ÷ セッション経過時間（分）</code><br>
                            <strong>使ったデータ:</strong> 前進スキップのイベント件数を、経過時間（分単位、最小0.1分）で割った値。<br>
                            1分あたり何回スキップしたかを示す。経過時間が極端に短い場合の除算ゼロを防ぐため最小値0.1分を下限とする。
                          </dd>
                        </dl>
                      </div>
                    </details>

                    <div id="kmeans-loading" class="text-muted small" style="display:none;">
                      <span class="spinner-border spinner-border-sm me-1"></span>クラスタリング実行中…
                    </div>

                    <div id="kmeans-result" style="display:none;">
                      <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered mb-0" style="font-size:0.82rem;">
                          <thead class="table-light">
                            <tr>
                              <th>色</th>
                              <th>件数</th>
                              <th title="動画時間 ÷ 経過時間（一時停止含む）">有効速度</th>
                              <th title="一時停止・シーク除いた再生中の速度">再生速度</th>
                              <th title="スキップした動画時間の割合">スキップ率</th>
                              <th title="経過時間 ÷ 動画長">期間比</th>
                              <th>自動推定</th>
                              <th>グループ名（確定）</th>
                            </tr>
                          </thead>
                          <tbody id="kmeans-cluster-tbody"></tbody>
                        </table>
                      </div>
                      <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-sm btn-secondary" onclick="previewKmeansClusters()">
                          チャートにプレビュー
                        </button>
                        <button class="btn btn-sm btn-success" onclick="saveKmeansClusters()">
                          このグループ分けで保存（未分類のみ）
                        </button>
                        <button class="btn btn-sm btn-warning" onclick="saveKmeansClusters(true)">
                          全セッションに上書き保存
                        </button>
                      </div>
                      <div id="kmeans-save-msg" class="mt-2 small"></div>
                    </div>
                  </div>

                  <!-- 手動分類 -->
                  <div class="border rounded p-3 mb-3" style="background:#f0f7ff;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                      <span class="fw-semibold">🔧 手動分類（条件でフィルタリング）</span>
                      <span class="text-muted small">条件を設定してプレビュー → 保存でDBグループに一括登録</span>
                    </div>
                    <table class="table table-sm table-borderless mb-2" style="max-width:600px;">
                      <thead><tr class="text-muted small"><th>指標</th><th>条件</th><th>閾値</th></tr></thead>
                      <tbody>
                        <% [
                          ['effective_speed', '有効速度 (×)',   '1.3',  '0.01'],
                          ['playing_speed',   '再生速度 (×)',   '1.3',  '0.01'],
                          ['skip_coverage',   'スキップ率 (%)', '12',   '1'   ],
                          ['duration_ratio',  '期間比',         '0.15', '0.01']
                        ].each do |key, label, default_val, step| %>
                          <tr>
                            <td class="align-middle small fw-semibold" style="width:160px;"><%= label %></td>
                            <td class="align-middle" style="width:130px;">
                              <select id="mcOp_<%= key %>" class="form-select form-select-sm">
                                <option value="none">使わない</option>
                                <option value="gte">以上 (≥)</option>
                                <option value="lte">以下 (≤)</option>
                              </select>
                            </td>
                            <td class="align-middle">
                              <input type="number" id="mcVal_<%= key %>" class="form-control form-control-sm"
                                     style="width:100px;" value="<%= default_val %>" step="<%= step %>">
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                    <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                      <label class="small fw-semibold mb-0">保存先グループ:</label>
                      <select id="mcTargetGroup" class="form-select form-select-sm" style="width:auto;">
                        <% LearningSession::SESSION_GROUPS.each do |key, label| %>
                          <option value="<%= key %>"><%= label %></option>
                        <% end %>
                      </select>
                      <button class="btn btn-sm btn-outline-primary" onclick="previewManualClassification()">プレビュー</button>
                      <button class="btn btn-sm btn-success" onclick="saveManualClassification()">保存</button>
                      <button class="btn btn-sm btn-outline-secondary" onclick="clearManualPreview()">プレビュー解除</button>
                      <span id="mc-msg" class="small text-muted ms-1"></span>
                    </div>
                    <div id="mc-preview-count" class="mt-1 small text-muted"></div>
                  </div>

                  <!-- 横軸（経過時間）の最大値スライダー -->
                  <div class="mt-3 mb-3 p-3 border rounded bg-light">
                    <div class="fw-semibold small mb-2">横軸の最大表示時間</div>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                      <input type="range" class="form-range" id="ucXAxisMaxSlider"
                             min="1" max="300" value="120" step="1" style="flex:1; min-width:120px;"
                             oninput="updateUcXAxisSliderDisplay()">
                      <span id="ucXAxisMaxDisplay" class="fw-semibold text-nowrap" style="min-width:4.5rem;">120 分</span>
                      <button type="button" class="btn btn-sm btn-primary" onclick="applyUcXAxisMax()">設定</button>
                      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetUcXAxisMax()">リセット</button>
                    </div>
                    <div class="text-muted mt-1" style="font-size:0.76rem;">
                      設定した時間より長い視聴履歴は右側が見切れます。リセットで全データに合わせた自動スケールに戻ります。
                    </div>
                  </div>

                  <!-- グラフ表示フィルター -->
                  <div class="mb-3 p-2 border rounded" style="background:#f8f9fa;">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                      <span class="fw-semibold small text-muted me-1">グラフ表示フィルター:</span>
                      <!-- ビジュアル分類フィルター -->
                      <div id="uc-visual-filter" class="d-flex flex-wrap gap-1">
                        <button class="btn btn-sm btn-secondary" id="ucVfAll" onclick="filterUcByGroup(null)">すべて表示</button>
                        <button class="btn btn-sm btn-outline-primary" id="ucVfA" onclick="filterUcByGroup('groupA')">グループA</button>
                        <button class="btn btn-sm btn-outline-success" id="ucVfB" onclick="filterUcByGroup('groupB')">グループB</button>
                        <button class="btn btn-sm btn-outline-warning" id="ucVfC" onclick="filterUcByGroup('groupC')">グループC</button>
                        <button class="btn btn-sm btn-outline-danger" id="ucVfD" onclick="filterUcByGroup('groupD')">グループD</button>
                        <button class="btn btn-sm btn-outline-secondary" id="ucVfNull" onclick="filterUcByGroup('__unclassified__')">未分類</button>
                      </div>
                      <!-- DBグループ分類フィルター -->
                      <div id="uc-db-filter" class="d-flex flex-wrap gap-1" style="display:none;">
                        <button class="btn btn-sm btn-secondary" id="ucDfAll" onclick="filterUcByDbGroup(null)">すべて表示</button>
                        <button class="btn btn-sm btn-outline-primary" id="ucDfNormal" onclick="filterUcByDbGroup('normal')">等倍</button>
                        <button class="btn btn-sm" id="ucDfFast" style="border:1px solid #8B5CF6;color:#8B5CF6;" onclick="filterUcByDbGroup('fast_speed')">倍速</button>
                        <button class="btn btn-sm btn-outline-warning" id="ucDfSkip" onclick="filterUcByDbGroup('skip_heavy')">飛ばしが多い</button>
                        <button class="btn btn-sm btn-outline-danger" id="ucDfFastSkip" onclick="filterUcByDbGroup('fast_and_skip')">倍速と飛ばしの混在</button>
                        <button class="btn btn-sm" id="ucDfShort" style="border:1px solid #EC4899;color:#EC4899;" onclick="filterUcByDbGroup('too_short')">異様に視聴が短い</button>
                        <button class="btn btn-sm" id="ucDfLong" style="border:1px solid #14B8A6;color:#14B8A6;" onclick="filterUcByDbGroup('too_long')">視聴が超長い</button>
                        <button class="btn btn-sm btn-outline-secondary" id="ucDfNull" onclick="filterUcByDbGroup('__unclassified__')">未分類</button>
                      </div>
                    </div>
                  </div>

                  <!-- グラフ領域 -->
                  <div class="chart-container" style="position: relative; height: 800px; border: 2px dashed #ccc; padding: 10px; border-radius: 5px;">
                    <canvas id="userClassificationChart"></canvas>
                  </div>
                </div>

                <!-- 分類結果・統計表 -->
                <div class="mt-4">
                  <h5>分類結果と統計</h5>
                  <!-- ビジュアル分類 (A/B/C/D) -->
                  <div id="classificationStats" class="row"></div>
                  <!-- DBグループ分類 -->
                  <div id="dbClassificationStats" class="row" style="display:none;"></div>
                </div>
              </div>

              <!-- 9. 一時停止ヒートマップ -->
              <div class="tab-pane fade" id="pause-heatmap" role="tabpanel">
                <% if @pause_heatmap_data[:total_pauses] > 0 %>
                  <div class="alert alert-light border mb-3 py-2">
                    <strong>集計対象:</strong> 3秒〜10分の一時停止（誤操作・離席を除外）。
                    全 <strong><%= @pause_heatmap_data[:total_pauses] %></strong> 回 ／
                    合計停止時間 <strong><%= @pause_heatmap_data[:total_pause_time] %></strong> 秒を検出しました。
                  </div>
                <% else %>
                  <div class="alert alert-secondary mb-3 py-2">一時停止データがまだありません。</div>
                <% end %>

                <!-- グループフィルター -->
                <div class="mb-3 d-flex align-items-center gap-2 flex-wrap">
                  <label class="form-label mb-0 fw-semibold">グループで絞り込み:</label>
                  <select id="pauseGroupFilter" class="form-select form-select-sm" style="width:auto;"
                          onchange="updatePauseHeatmapBins()">
                    <option value="">すべて</option>
                    <% LearningSession::SESSION_GROUPS.each do |key, label| %>
                      <option value="<%= key %>"><%= label %></option>
                    <% end %>
                    <option value="__unset__">未分類</option>
                  </select>
                  <span id="pauseGroupCount" class="text-muted small"></span>
                </div>

                <!-- 集計間隔スライダー -->
                <div class="mb-4">
                  <label class="form-label">集計間隔: <strong><span id="pauseBucketSizeValue">30</span>秒</strong></label>
                  <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small">5秒</span>
                    <input type="range" class="form-range" id="pauseBucketSize" min="5" max="300" value="30" step="5" style="max-width: 320px;">
                    <span class="text-muted small">5分</span>
                    <button class="btn btn-sm btn-outline-primary ms-2" onclick="updatePauseHeatmapBins()">更新</button>
                  </div>
                  <small class="text-muted">動画を何秒単位で区切って集計するかを調整できます。</small>
                </div>

                <div class="mb-4">
                  <h6 class="mb-1">動画位置別 合計停止時間</h6>
                  <p class="text-muted small mb-2">赤いほど停止時間が長い箇所です。ツールチップで詳細を確認できます。</p>
                  <div style="position: relative; height: 300px;">
                    <canvas id="pauseHeatmapChart"></canvas>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 mb-3">
                    <h6 class="mb-1">一時停止時間の分布（ヒストグラム）</h6>
                    <p class="text-muted small mb-2">15〜120秒が書き取りタイムの目安です。</p>
                    <div style="position: relative; height: 220px;">
                      <canvas id="pauseHistogramChart"></canvas>
                    </div>
                  </div>
                  <div class="col-md-6 mb-3">
                    <h6 class="mb-1">動画位置別 一時停止回数</h6>
                    <p class="text-muted small mb-2">どの位置で最も多く一時停止されたかを示します。</p>
                    <div style="position: relative; height: 220px;">
                      <canvas id="pauseCountChart"></canvas>
                    </div>
                  </div>
                </div>
              </div>

<script>
  // 一時停止データを指定バケットサイズで再集計する
  function rebinPauseData(rawPauses, bucketSize) {
    var buckets = {};
    rawPauses.forEach(function(p) {
      var key = Math.floor(p.vt / bucketSize) * bucketSize;
      if (!buckets[key]) buckets[key] = { count: 0, total: 0 };
      buckets[key].count += 1;
      buckets[key].total += p.dur;
    });
    return Object.keys(buckets)
      .map(function(k) {
        var t = parseInt(k);
        var d = buckets[k];
        var min = Math.floor(t / 60);
        var sec = String(t % 60).padStart(2, '0');
        return {
          time: t,
          label: min + ':' + sec,
          pause_count: d.count,
          total_duration: Math.round(d.total * 10) / 10,
          avg_duration: Math.round(d.total / d.count * 10) / 10
        };
      })
      .sort(function(a, b) { return a.time - b.time; });
  }

  // 青→赤グラデーション色配列を生成
  function heatColorScale(items, key) {
    var max = Math.max.apply(null, items.map(function(d) { return d[key]; }).concat([1]));
    return items.map(function(d) {
      var ratio = d[key] / max;
      var r = Math.round(54  + (255 - 54)  * ratio);
      var g = Math.round(162 * (1 - ratio * 0.9));
      var b = Math.round(235 * (1 - ratio));
      return 'rgba(' + r + ',' + g + ',' + b + ',0.85)';
    });
  }

  // 黄→橙グラデーション色配列を生成
  function countColorScale(items) {
    var max = Math.max.apply(null, items.map(function(d) { return d.pause_count; }).concat([1]));
    return items.map(function(d) {
      var ratio = d.pause_count / max;
      return 'rgba(255,' + Math.round(159 - 90 * ratio) + ',64,0.85)';
    });
  }

  // グループフィルターを適用して raw 配列を絞り込む共通関数
  function applyGroupFilter(rawItems, selectId) {
    var g = (document.getElementById(selectId) || {}).value || '';
    if (!g) return rawItems;
    if (g === '__unset__') return rawItems.filter(function(p) { return !p.g; });
    return rawItems.filter(function(p) { return p.g === g; });
  }

  // ヒートマップ・停止回数チャートをリビンして更新
  window.updatePauseHeatmapBins = function() {
    var bucketSize = parseInt(document.getElementById('pauseBucketSize').value) || 30;
    var data = chartsData && chartsData.pause_heatmap_data;
    if (!data || !data.raw_pauses || data.raw_pauses.length === 0) return;

    var filtered = applyGroupFilter(data.raw_pauses, 'pauseGroupFilter');
    var countEl = document.getElementById('pauseGroupCount');
    if (countEl) countEl.textContent = filtered.length < data.raw_pauses.length
      ? '（' + filtered.length + ' / ' + data.raw_pauses.length + ' 件）' : '';

    var rebinned = rebinPauseData(filtered, bucketSize);
    var heatColors = heatColorScale(rebinned, 'total_duration');
    var cntColors  = countColorScale(rebinned);
    var labels     = rebinned.map(function(d) { return d.label; });

    if (chartInstances.pauseHeatmap) {
      var ds = chartInstances.pauseHeatmap.data.datasets[0];
      chartInstances.pauseHeatmap.data.labels = labels;
      ds.data            = rebinned.map(function(d) { return d.total_duration; });
      ds.backgroundColor = heatColors;
      ds.borderColor     = heatColors;
      ds._items          = rebinned;
      chartInstances.pauseHeatmap.update('none');
    }

    if (chartInstances.pauseCount) {
      var ds2 = chartInstances.pauseCount.data.datasets[0];
      chartInstances.pauseCount.data.labels = labels;
      ds2.data            = rebinned.map(function(d) { return d.pause_count; });
      ds2.backgroundColor = cntColors;
      ds2.borderColor     = cntColors;
      ds2._items          = rebinned;
      chartInstances.pauseCount.update('none');
    }
  };

  document.addEventListener('DOMContentLoaded', function() {
    var slider  = document.getElementById('pauseBucketSize');
    var display = document.getElementById('pauseBucketSizeValue');
    if (slider && display) {
      slider.addEventListener('input', function() { display.textContent = this.value; });
    }
  });

  document.getElementById('pause-heatmap-tab')?.addEventListener('shown.bs.tab', function() {
    ['pauseHeatmap', 'pauseHistogram', 'pauseCount'].forEach(function(k) {
      if (chartInstances[k]) { chartInstances[k].destroy(); chartInstances[k] = null; }
    });

    var data = chartsData && chartsData.pause_heatmap_data;
    if (!data || !data.heatmap || data.heatmap.length === 0) {
      ['pauseHeatmapChart', 'pauseHistogramChart', 'pauseCountChart'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.parentElement.innerHTML = '<p class="text-muted text-center py-4">一時停止データがありません</p>';
      });
      return;
    }

    // スライダーをデフォルト値（30秒）にリセット
    var slider = document.getElementById('pauseBucketSize');
    var display = document.getElementById('pauseBucketSizeValue');
    if (slider) { slider.value = 30; }
    if (display) { display.textContent = '30'; }

    var heatColors = heatColorScale(data.heatmap, 'total_duration');

    // 1. ヒートマップ（合計停止時間）
    chartInstances.pauseHeatmap = new Chart(document.getElementById('pauseHeatmapChart'), {
      type: 'bar',
      data: {
        labels: data.heatmap.map(function(d) { return d.label; }),
        datasets: [{
          label: '合計停止時間（秒）',
          data: data.heatmap.map(function(d) { return d.total_duration; }),
          backgroundColor: heatColors,
          borderColor: heatColors,
          borderWidth: 1,
          _items: data.heatmap
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                var items = ctx.dataset._items || data.heatmap;
                var item  = items[ctx.dataIndex];
                if (!item) return '';
                return ['合計停止時間: ' + item.total_duration + '秒',
                        '停止回数: '     + item.pause_count    + '回',
                        '平均停止時間: ' + item.avg_duration   + '秒'];
              }
            }
          }
        },
        scales: {
          x: { title: { display: true, text: '動画内位置（分:秒）' } },
          y: { title: { display: true, text: '合計停止時間（秒）' }, beginAtZero: true }
        }
      }
    });

    // 2. ヒストグラム（停止時間の長さ分布）
    chartInstances.pauseHistogram = new Chart(document.getElementById('pauseHistogramChart'), {
      type: 'bar',
      data: {
        labels: data.histogram.labels,
        datasets: [{
          label: '停止回数',
          data: data.histogram.values,
          backgroundColor: 'rgba(54, 162, 235, 0.8)',
          borderColor: 'rgba(54, 162, 235, 1)',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { title: { display: true, text: '停止時間の長さ' } },
          y: { title: { display: true, text: '回数' }, beginAtZero: true, ticks: { stepSize: 1 } }
        }
      }
    });

    // 3. 停止回数チャート（黄→橙グラデーション）
    var cntColors = countColorScale(data.heatmap);
    chartInstances.pauseCount = new Chart(document.getElementById('pauseCountChart'), {
      type: 'bar',
      data: {
        labels: data.heatmap.map(function(d) { return d.label; }),
        datasets: [{
          label: '停止回数',
          data: data.heatmap.map(function(d) { return d.pause_count; }),
          backgroundColor: cntColors,
          borderColor: cntColors,
          borderWidth: 1,
          _items: data.heatmap
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                var items = ctx.dataset._items || data.heatmap;
                var item  = items[ctx.dataIndex];
                if (!item) return '';
                return ['停止回数: '     + item.pause_count    + '回',
                        '合計停止時間: ' + item.total_duration + '秒',
                        '平均停止時間: ' + item.avg_duration   + '秒'];
              }
            }
          }
        },
        scales: {
          x: { title: { display: true, text: '動画内位置（分:秒）' } },
          y: { title: { display: true, text: '停止回数' }, beginAtZero: true, ticks: { stepSize: 1 } }
        }
      }
    });

    // タブ初期化直後にグループフィルターを適用
    updatePauseHeatmapBins();
  });
</script>

              <!-- 10. スキップ分析 -->
              <div class="tab-pane fade" id="skip-heatmap" role="tabpanel">
                <% sd = @skip_heatmap_data %>
                <% if sd[:total_forward_skips] > 0 || sd[:total_backward_seeks] > 0 %>
                  <div class="alert alert-light border mb-3 py-2">
                    前進スキップ <strong><%= sd[:total_forward_skips] %></strong> 回（合計 <strong><%= sd[:total_skipped_seconds] %></strong> 秒分スキップ）／
                    巻き戻し <strong><%= sd[:total_backward_seeks] %></strong> 回
                  </div>
                <% else %>
                  <div class="alert alert-secondary mb-3 py-2">スキップデータがまだありません。</div>
                <% end %>

                <!-- グループフィルター -->
                <div class="mb-3 d-flex align-items-center gap-2 flex-wrap">
                  <label class="form-label mb-0 fw-semibold">グループで絞り込み:</label>
                  <select id="skipGroupFilter" class="form-select form-select-sm" style="width:auto;"
                          onchange="updateSkipHeatmapBins()">
                    <option value="">すべて</option>
                    <% LearningSession::SESSION_GROUPS.each do |key, label| %>
                      <option value="<%= key %>"><%= label %></option>
                    <% end %>
                    <option value="__unset__">未分類</option>
                  </select>
                  <span id="skipGroupCount" class="text-muted small"></span>
                </div>

                <!-- 集計間隔スライダー -->
                <div class="mb-4">
                  <label class="form-label">集計間隔: <strong><span id="skipBucketSizeValue">30</span>秒</strong></label>
                  <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small">5秒</span>
                    <input type="range" class="form-range" id="skipBucketSize" min="5" max="300" value="30" step="5" style="max-width: 320px;">
                    <span class="text-muted small">5分</span>
                    <button class="btn btn-sm btn-outline-primary ms-2" onclick="updateSkipHeatmapBins()">更新</button>
                  </div>
                  <small class="text-muted">動画を何秒単位で区切って集計するかを調整できます。</small>
                </div>

                <div class="mb-4">
                  <h6 class="mb-1">スキップされた区間マップ</h6>
                  <p class="text-muted small mb-2">前進スキップによって「飛ばされた」回数が多いほど赤くなります。棒が高い箇所はよく飛ばされる区間です。</p>
                  <div style="position: relative; height: 280px;">
                    <canvas id="skippedOverChart"></canvas>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 mb-3">
                    <h6 class="mb-1">スキップ開始位置</h6>
                    <p class="text-muted small mb-2">ここからスキップが多く発生した位置です。</p>
                    <div style="position: relative; height: 220px;">
                      <canvas id="skipSourceChart"></canvas>
                    </div>
                  </div>
                  <div class="col-md-6 mb-3">
                    <h6 class="mb-1">スキップ着地位置</h6>
                    <p class="text-muted small mb-2">スキップ後に再生が再開された位置です。</p>
                    <div style="position: relative; height: 220px;">
                      <canvas id="skipDestChart"></canvas>
                    </div>
                  </div>
                  <div class="col-md-6 mb-3">
                    <h6 class="mb-1">巻き戻し着地位置</h6>
                    <p class="text-muted small mb-2">後退シーク（見直し）が多い箇所です。</p>
                    <div style="position: relative; height: 220px;">
                      <canvas id="backwardSeekChart"></canvas>
                    </div>
                  </div>
                  <div class="col-md-6 mb-3">
                    <h6 class="mb-1">スキップ距離の分布</h6>
                    <p class="text-muted small mb-2">一度にどのくらいの長さをスキップするかの分布です。</p>
                    <div style="position: relative; height: 220px;">
                      <canvas id="skipHistogramChart"></canvas>
                    </div>
                  </div>
                </div>
              </div>

<script>
  // スキップデータを指定バケットサイズで再集計
  function rebinSkipData(rawSkips, bucketSize, type) {
    var buckets = {};
    rawSkips.forEach(function(s) {
      if (type === 'skipped_over' && s.dir === 'forward') {
        var fb = Math.floor(s.from / bucketSize) * bucketSize;
        var tb = Math.floor(s.to   / bucketSize) * bucketSize;
        for (var b = fb; b <= tb; b += bucketSize) {
          buckets[b] = (buckets[b] || 0) + 1;
        }
      } else if (type === 'source' && s.dir === 'forward') {
        var k = Math.floor(s.from / bucketSize) * bucketSize;
        buckets[k] = (buckets[k] || 0) + 1;
      } else if (type === 'dest' && s.dir === 'forward') {
        var k = Math.floor(s.to / bucketSize) * bucketSize;
        buckets[k] = (buckets[k] || 0) + 1;
      } else if (type === 'backward' && s.dir === 'backward') {
        var k = Math.floor(s.to / bucketSize) * bucketSize;
        buckets[k] = (buckets[k] || 0) + 1;
      }
    });
    return Object.keys(buckets).map(function(k) {
      var t = parseInt(k);
      return { time: t, label: Math.floor(t/60) + ':' + String(t%60).padStart(2,'0'), count: buckets[k] };
    }).sort(function(a,b){ return a.time - b.time; });
  }

  function skipColorScale(items, color) {
    var max = Math.max.apply(null, items.map(function(d){ return d.count; }).concat([1]));
    return items.map(function(d) {
      var r = color[0], g = color[1], b = color[2];
      var ratio = d.count / max;
      if (color === 'red') {
        r = Math.round(54  + (220 - 54)  * ratio);
        g = Math.round(130 * (1 - ratio * 0.9));
        b = Math.round(235 * (1 - ratio));
      }
      return 'rgba(' + r + ',' + g + ',' + b + ',0.85)';
    });
  }

  window.updateSkipHeatmapBins = function() {
    var bs = parseInt(document.getElementById('skipBucketSize').value) || 30;
    var data = chartsData && chartsData.skip_heatmap_data;
    if (!data || !data.raw_skips) return;

    var filtered = applyGroupFilter(data.raw_skips, 'skipGroupFilter');
    var countEl = document.getElementById('skipGroupCount');
    if (countEl) countEl.textContent = filtered.length < data.raw_skips.length
      ? '（' + filtered.length + ' / ' + data.raw_skips.length + ' 件）' : '';

    var specs = [
      { key: 'skippedOver', type: 'skipped_over', chartKey: 'skippedOver' },
      { key: 'skipSource',  type: 'source',        chartKey: 'skipSource' },
      { key: 'skipDest',    type: 'dest',           chartKey: 'skipDest' },
      { key: 'backwardSeek', type: 'backward',      chartKey: 'backwardSeek' }
    ];
    specs.forEach(function(spec) {
      var chart = chartInstances[spec.chartKey];
      if (!chart) return;
      var rebinned = rebinSkipData(filtered, bs, spec.type);
      var max = Math.max.apply(null, rebinned.map(function(d){ return d.count; }).concat([1]));
      var colors = rebinned.map(function(d) {
        var ratio = d.count / max;
        var r = Math.round(54  + (220 - 54)  * ratio);
        var g = Math.round(130 * (1 - ratio * 0.9));
        var b = Math.round(235 * (1 - ratio));
        return 'rgba(' + r + ',' + g + ',' + b + ',0.85)';
      });
      chart.data.labels = rebinned.map(function(d){ return d.label; });
      chart.data.datasets[0].data            = rebinned.map(function(d){ return d.count; });
      chart.data.datasets[0].backgroundColor = colors;
      chart.data.datasets[0].borderColor     = colors;
      chart.update('none');
    });
  };

  document.addEventListener('DOMContentLoaded', function() {
    var sl = document.getElementById('skipBucketSize');
    var dv = document.getElementById('skipBucketSizeValue');
    if (sl && dv) sl.addEventListener('input', function(){ dv.textContent = this.value; });
  });

  document.getElementById('skip-heatmap-tab')?.addEventListener('shown.bs.tab', function() {
    ['skippedOver','skipSource','skipDest','backwardSeek'].forEach(function(k) {
      if (chartInstances[k]) { chartInstances[k].destroy(); chartInstances[k] = null; }
    });

    var data = chartsData && chartsData.skip_heatmap_data;
    var noData = !data || !data.raw_skips || data.raw_skips.length === 0;
    if (noData) {
      ['skippedOverChart','skipSourceChart','skipDestChart','backwardSeekChart','skipHistogramChart'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.parentElement.innerHTML = '<p class="text-muted text-center py-4">スキップデータがありません</p>';
      });
      return;
    }

    // スライダーをデフォルト値にリセット
    var sl = document.getElementById('skipBucketSize');
    var dv = document.getElementById('skipBucketSizeValue');
    if (sl) sl.value = 30;
    if (dv) dv.textContent = '30';

    function makeColors(items) {
      var max = Math.max.apply(null, items.map(function(d){ return d.count; }).concat([1]));
      return items.map(function(d) {
        var ratio = d.count / max;
        var r = Math.round(54  + (220 - 54)  * ratio);
        var g = Math.round(130 * (1 - ratio * 0.9));
        var b = Math.round(235 * (1 - ratio));
        return 'rgba(' + r + ',' + g + ',' + b + ',0.85)';
      });
    }

    function makeBarChart(canvasId, items, yLabel, tooltipLabel) {
      var colors = makeColors(items);
      return new Chart(document.getElementById(canvasId), {
        type: 'bar',
        data: {
          labels: items.map(function(d){ return d.label; }),
          datasets: [{ label: tooltipLabel, data: items.map(function(d){ return d.count; }),
            backgroundColor: colors, borderColor: colors, borderWidth: 1 }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { title: { display: true, text: '動画内位置（分:秒）' } },
            y: { title: { display: true, text: yLabel }, beginAtZero: true, ticks: { stepSize: 1 } }
          }
        }
      });
    }

    chartInstances.skippedOver  = makeBarChart('skippedOverChart',  data.skipped_over,      '通過回数', 'スキップ通過回数');
    chartInstances.skipSource   = makeBarChart('skipSourceChart',   data.skip_sources,      '回数',     'スキップ開始回数');
    chartInstances.skipDest     = makeBarChart('skipDestChart',     data.skip_destinations, '回数',     'スキップ着地回数');
    chartInstances.backwardSeek = makeBarChart('backwardSeekChart', data.backward_seeks,    '回数',     '巻き戻し着地回数');

    // ヒストグラム（スキップ距離）
    chartInstances.skipHistogram = new Chart(document.getElementById('skipHistogramChart'), {
      type: 'bar',
      data: {
        labels: data.histogram.labels,
        datasets: [{ label: 'スキップ回数', data: data.histogram.values,
          backgroundColor: 'rgba(108, 117, 125, 0.75)', borderColor: 'rgba(108, 117, 125, 1)', borderWidth: 1 }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { title: { display: true, text: 'スキップ距離' } },
          y: { title: { display: true, text: '回数' }, beginAtZero: true, ticks: { stepSize: 1 } }
        }
      }
    });

    // タブ初期化直後にグループフィルターを適用（4つのヒートマップ）
    updateSkipHeatmapBins();
  });
</script>

