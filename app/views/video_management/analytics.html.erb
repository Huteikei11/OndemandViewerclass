// ===== セッショングループ =====
(function() {
  var CSRF_TOKEN = document.querySelector('meta[name="csrf-token"]')?.content || '';

  // グループ選択 → 即時保存
  document.querySelectorAll('.session-group-select').forEach(function(sel) {
    sel.addEventListener('change', function() {
      var url   = sel.dataset.url;
      var icon  = sel.parentElement.querySelector('.group-saved-icon');
      var group = sel.value;

      fetch(url, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
        body: JSON.stringify({ session_group: group })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.ok) {
          // 行の data-group を更新
          var row = sel.closest('tr');
          if (row) row.dataset.group = group || '__unset__';
          // ✓ アイコンを一瞬表示
          if (icon) {
            icon.style.display = 'inline';
            setTimeout(function() { icon.style.display = 'none'; }, 1500);
          }
        } else {
          alert('保存失敗: ' + (data.error || '不明なエラー'));
          // 元の値に戻す (ページリロードで確実に戻す)
          location.reload();
        }
      })
      .catch(function() { alert('通信エラーが発生しました'); });
    });
  });

  // グループフィルター
  var filterSel = document.getElementById('sessionGroupFilter');
  if (filterSel) {
    filterSel.addEventListener('change', function() {
      var val = filterSel.value;
      document.querySelectorAll('#sessionTable tbody tr').forEach(function(row) {
        if (!val) {
          row.style.display = '';
        } else {
          row.style.display = (row.dataset.group === val) ? '' : 'none';
        }
      });
    });
  }

  // 名前ソート
  var nameSortState = 0; // 0=元の順, 1=昇順, 2=降順
  window.sortSessionsByName = function() {
    var tbody = document.querySelector('#sessionTable tbody');
    if (!tbody) return;
    var rows = Array.from(tbody.querySelectorAll('tr'));
    nameSortState = (nameSortState + 1) % 3;

    if (nameSortState === 1) {
      rows.sort(function(a, b) {
        return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'ja');
      });
    } else if (nameSortState === 2) {
      rows.sort(function(a, b) {
        return (b.dataset.name || '').localeCompare(a.dataset.name || '', 'ja');
      });
    } else {
      rows.sort(function(a, b) {
        return parseInt(a.dataset.idx, 10) - parseInt(b.dataset.idx, 10);
      });
    }

    var icon = document.getElementById('name-sort-icon');
    if (icon) icon.textContent = ['↕', '↑', '↓'][nameSortState];

    rows.forEach(function(row) { tbody.appendChild(row); });
  };

  // セッション一括削除
  window.onSessionCbChange = function() {
    var checked = document.querySelectorAll('.session-row-cb:checked');
    var btn     = document.getElementById('bulkDeleteBtn');
    var all     = document.getElementById('selectAllSessions');
    var total   = document.querySelectorAll('.session-row-cb').length;
    if (btn) {
      if (checked.length > 0) {
        btn.textContent = '選択した ' + checked.length + ' 件を削除';
        btn.classList.remove('d-none');
      } else {
        btn.classList.add('d-none');
      }
    }
    if (all) {
      all.indeterminate = checked.length > 0 && checked.length < total;
      all.checked       = checked.length === total && total > 0;
    }
  };

  window.toggleAllSessionCheckboxes = function(state) {
    document.querySelectorAll('.session-row-cb').forEach(function(cb) {
      if (cb.closest('tr').style.display !== 'none') cb.checked = state;
    });
    onSessionCbChange();
  };

  window.bulkDeleteSessions = function() {
    var ids = Array.from(document.querySelectorAll('.session-row-cb:checked')).map(function(cb) {
      return parseInt(cb.value, 10);
    });
    if (!ids.length) return;
    if (!confirm(ids.length + ' 件のセッションを削除してもよろしいですか？\n関連するすべてのイベントデータも削除されます。この操作は取り消せません。')) return;

    var csrf = document.querySelector('meta[name="csrf-token"]');
    fetch('/video_management/delete_sessions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrf ? csrf.content : ''
      },
      body: JSON.stringify({ session_ids: ids })
    })
    .then(function(res) { return res.json(); })
    .then(function(body) {
      if (body.success) {
        // 削除した行を DOM から除去
        ids.forEach(function(id) {
          var cb  = document.querySelector('.session-row-cb[value="' + id + '"]');
          if (cb) cb.closest('tr').remove();
        });
        onSessionCbChange();
        // 全行削除なら「データなし」表示も考慮してリロード
        if (!document.querySelector('.session-row-cb')) location.reload();
      } else {
        alert('削除に失敗しました: ' + (body.error || '不明なエラー'));
      }
    })
    .catch(function() { alert('削除リクエストの送信に失敗しました。'); });
  };

  // ユーザー分類分析 横軸スライダー
  window.updateUcXAxisSliderDisplay = function() {
    var slider  = document.getElementById('ucXAxisMaxSlider');
    var display = document.getElementById('ucXAxisMaxDisplay');
    if (slider && display) display.textContent = slider.value + ' 分';
  };

  window.applyUcXAxisMax = function() {
    var chart = chartInstances.userClassification;
    if (!chart) return;
    var minutes = parseInt(document.getElementById('ucXAxisMaxSlider').value, 10);
    // ① zoom状態をクリア（内部のoriginalスケールをリセット）
    chart.resetZoom();
    // ② その直後にmaxを上書き（resetZoom後はoriginalが復元されているので上書きが有効）
    chart.options.scales.x.max = minutes * 60;
    // ③ zoom pluginに干渉されずに反映（beforeUpdateでpluginが新maxをoriginalとして記憶する）
    chart.update('none');
  };

  window.resetUcXAxisMax = function() {
    var chart = chartInstances.userClassification;
    if (!chart) return;
    delete chart.options.scales.x.max;
    // zoom pluginのoriginalに max なし状態を記憶させてからリセット
    chart.update('none');
    chart.resetZoom();
    var maxSec = 0;
    chart.data.datasets.forEach(function(ds) {
      (ds.data || []).forEach(function(p) { if ((p.x || 0) > maxSec) maxSec = p.x; });
    });
    var maxMin = Math.max(Math.ceil(maxSec / 60), 10);
    var slider  = document.getElementById('ucXAxisMaxSlider');
    var display = document.getElementById('ucXAxisMaxDisplay');
    if (slider) {
      slider.value = maxMin;
      if (display) display.textContent = maxMin + ' 分';
    }
  };

  // 集中スコア推移 横軸スライダー
  window.updateXAxisSliderDisplay = function() {
    var slider  = document.getElementById('xAxisMaxSlider');
    var display = document.getElementById('xAxisMaxDisplay');
    if (slider && display) display.textContent = slider.value + ' 分';
  };

  window.applyXAxisMax = function() {
    var chart = chartInstances.scoreTimeline;
    if (!chart) return;
    var minutes = parseInt(document.getElementById('xAxisMaxSlider').value, 10);
    chart.resetZoom();
    chart.options.scales.x.max = minutes * 60;
    chart.update('none');
  };

  window.resetXAxisMax = function() {
    var chart = chartInstances.scoreTimeline;
    if (!chart) return;
    delete chart.options.scales.x.max;
    chart.update('none');
    chart.resetZoom();
    // スライダーをデータの最大値に戻す
    var maxSec = 0;
    chart.data.datasets.forEach(function(ds) {
      (ds.data || []).forEach(function(p) { if ((p.x || 0) > maxSec) maxSec = p.x; });
    });
    var maxMin = Math.max(Math.ceil(maxSec / 60), 10);
    var slider  = document.getElementById('xAxisMaxSlider');
    var display = document.getElementById('xAxisMaxDisplay');
    if (slider) {
      slider.value = maxMin;
      if (display) display.textContent = maxMin + ' 分';
    }
  };
})();
</script>
