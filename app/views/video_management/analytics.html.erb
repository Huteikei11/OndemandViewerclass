      <!-- 動画操作統計（1分以上のセッション平均） -->
      <div class="card mb-4">
        <div class="card-header">
          <h3>動画操作統計 <small class="text-muted">(1分以上のセッション平均)</small></h3>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-3">
              <div class="card text-center">
                <div class="card-body">
                  <h5 class="card-title">⏸️ 一時停止</h5>
                  <h2 class="text-warning"><%= @avg_pause_count %></h2>
                  <p class="text-muted">回/セッション</p>
