                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="${chartType}_response_markers" 
                       checked onchange="toggleResponseMarkers('${chartType}', this.checked)">
                <label class="form-check-label" for="${chartType}_response_markers">
                  <span style="color: #ffc0cb;">▲</span><span style="color: #ff69b4;">○</span><span style="color: #c71585;">◆</span> <strong>反応速度マーカー（ピンク系）を表示</strong>
                </label>
              </div>
            </div>
            <button class="btn btn-danger btn-sm" onclick="deleteSelectedSessions('${chartType}')">
              <i class="bi bi-trash"></i> 選択したセッションを削除
            </button>
          </div>
        </div>
      </div>
    </div>
  `;
  
  // セッションリストを追加
  html += datasets.map((dataset, index) => `
    <div class="col-md-4 col-sm-6 mb-2">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="${chartType}_session_${dataset.session_id}" 
               checked onchange="toggleSession('${chartType}', ${dataset.session_id})">
