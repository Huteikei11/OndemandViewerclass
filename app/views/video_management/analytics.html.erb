function initializeAnalyticsCharts() {
  // 既に初期化中なら返す
  if (isInitializingCharts) {
    console.log('[グラフ初期化] 既に初期化中のためスキップ');
    return;
  }
  
  // Chart.jsが読み込まれているか確認
  if (typeof Chart === 'undefined') {
    console.log('Chart.js is not loaded yet. Retrying...');
    setTimeout(initializeAnalyticsCharts, 100);
    return;
  }
  
  // canvas要素が存在するか確認
  const scoreTimelineCtx = document.getElementById('scoreTimelineChart');
  if (!scoreTimelineCtx) {
    console.log('Canvas elements not ready yet. Retrying...');
    setTimeout(initializeAnalyticsCharts, 100);
    return;
  }
  
  // 初期化フラグをセット
  isInitializingCharts = true;
  
  // 初期化済みの場合は前のチャートを確実に破棄
  if (chartsInitialized) {
    console.log('[グラフ初期化] 前のチャートを破棄...');
    Object.keys(chartInstances).forEach(key => {
      try {
        if (chartInstances[key]) {
          chartInstances[key].destroy();
          delete chartInstances[key];
        }
      } catch (e) {
        console.error(`[グラフ初期化] ${key} チャート破棄エラー:`, e);
      }
    });
    chartInstances = {};
  }
  
  // ビデオIDを定義
  const videoId = <%= @video.id %>;
  
  // 共通のChart.jsオプション
  const commonOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        display: true,
        position: 'top'
      }
    }
  };

  // 1. 集中スコア推移グラフ
  if (scoreTimelineCtx) {
    // 前のscoreTimeline fetchをキャンセル
    if (scoreTimelineAbortController) {
      scoreTimelineAbortController.abort();
      console.log('[scoreTimeline] 前の AJAX リクエストをキャンセルしました');
    }
    scoreTimelineAbortController = new AbortController();
    
    // scoreTimelineの既存チャートを確実に破棄
    if (chartInstances.scoreTimeline) {
      try {
        chartInstances.scoreTimeline.destroy();
        delete chartInstances.scoreTimeline;
        console.log('[scoreTimeline] 既存チャートを破棄しました');
      } catch (e) {
        console.error('[scoreTimeline] チャート破棄エラー:', e);
      }
    }
    
    // AJAX でデータを取得
    fetch(`/video_management/get_chart_data?video_id=${videoId}&chart_type=score_timeline`, {
      signal: scoreTimelineAbortController.signal
    })
      .then(response => {
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(result => {
        if (!result.data || !Array.isArray(result.data)) {
          console.error('[scoreTimeline] Invalid data format:', result);
          throw new Error('Invalid data format from server');
        }
        
        // チャートが既に存在しないか確認（他の初期化がないか確認）
        if (chartInstances.scoreTimeline) {
          console.warn('[scoreTimeline] 既に別の初期化でチャートが作成されています。スキップします。');
          return;
        }
        
        const scoreTimelineData = result.data || [];
        
        // チャンク読み込み対応：複数ページを統合
        if (result.pagination && result.pagination.has_next) {
          console.log('[scoreTimeline] チャンク読み込み開始: ページ 1/' + result.pagination.total_pages);
          return loadScoreTimelineChunks(scoreTimelineData, result.pagination);
        }
        
        return scoreTimelineData;
      })
      .then(scoreTimelineData => {
        // 分類グラフから利用できるようにグローバル変数に保存
        window.scoreTimelineData = scoreTimelineData;
        console.log('[scoreTimeline] window.scoreTimelineData に保存完了:', scoreTimelineData.length, 'セッション');
        
        const videoOperationsMarkers = <%= raw @video_operations_markers.to_json %>;
        const responseTimeMarkers = <%= raw @response_time_markers.to_json %>;
        
        // ここから Chart 初期化開始
    
    // ユーザーごとの色を決定する関数（20色パレット）
    const userColors = [
      // 既存の明るい色（前半10色）
      '#FF6B6B', // 赤
      '#4ECDC4', // 青緑
      '#45B7D1', // 青
      '#FFA07A', // オレンジ
      '#98D8C8', // 緑
      '#F7DC6F', // 黄色
      '#BB8FCE', // 紫
      '#85C1E2', // 薄い青
      '#F8B88B', // 薄いオレンジ
      '#AED6F1', // 薄い青2
      // 追加の10色（濃い彩度で区別性向上）
      '#E74C3C', // 濃い赤
      '#16A085', // 濃い青緑
      '#2E86C1', // 濃い青
      '#E67E22', // 濃いオレンジ
      '#27AE60', // 濃い緑
      '#F39C12', // 濃い黄色
      '#8E44AD', // 濃い紫
      '#2980B9', // 濃い青
      '#C0392B', // 深い赤
      '#1ABC9C'  // ターコイズ
    ];
    
    // ユーザーIDごとにカラーを割り当てるマップを作成
    window.colorByUserLineColors = {};
    const uniqueUserIds = [...new Set(scoreTimelineData.map(s => s.user_id))];
    
    // ユーザー数が色パレットを超える場合、警告を表示
    if (uniqueUserIds.length > userColors.length) {
      console.warn(`⚠️ 警告: ユーザー数(${uniqueUserIds.length})が色パレット(${userColors.length})を超えています。一部のユーザーが同じ色になります`);
    }
    
    uniqueUserIds.forEach((userId, index) => {
      window.colorByUserLineColors[userId] = userColors[index % userColors.length];
    });
    
    console.log('[分析グラフ] ユーザーカラーマップ作成:', window.colorByUserLineColors);
    console.log(`[分析グラフ] ユーザー数: ${uniqueUserIds.length}, 色数: ${userColors.length}`);
    
    // 線の色をグレーに統一
    const lineColor = 'rgba(128, 128, 128, 0.5)'; // グレー
    const operationColor = '#6f42c1'; // 紫色
    const responseQuickColor = '#ff65B2'; // 薄いピンク色（素早い回答用）
    const responseNormalColor = '#ff007F'; // ピンク色（普通の回答用）
    const responseSlowColor = '#98004c'; // 薄暗いピンク色（遅延用）
    const quickCheckColor = '#17a2b8'; // 水色（速い問題確認用）

    // 集中度スコアで色を決定する関数
    const getColorByScore = (score) => {
      if (score <= 25) return '#dc3545'; // 赤
      if (score <= 50) return '#fd7e14'; // オレンジ
      if (score <= 75) return '#ffc107'; // 黄色
      return '#28a745'; // 緑
    };

    // データセットを作成（セッションごとにグループ化）
    const datasets = [];
    const sessionDatasetGroups = {}; // セッションIDごとのデータセットインデックスを記録
    
    // 各セッションのデータを追加
    scoreTimelineData.forEach((session, sessionIndex) => {
      const sessionData = session.data.map(point => ({
        x: point.x,
        y: point.video_time || 0,
        score: point.y,
        video_time: point.video_time,
        color: getColorByScore(point.y)
      }));
      
      // 集中スコアラインを追加
      const lineDatasetIndex = datasets.length;
      datasets.push({
        label: session.label,
        data: sessionData,
        borderColor: lineColor,
        borderWidth: 2,
        showLine: true,
        tension: 0,
        pointRadius: 1,
        pointHoverRadius: 5,
        pointBackgroundColor: sessionData.map(d => d.color),
        pointBorderColor: sessionData.map(d => d.color),
        order: 2,
        sessionId: session.session_id,
        userId: session.user_id // ユーザーIDも保存
      });
      
      // このセッションに属するデータセットのインデックスを記録
      sessionDatasetGroups[session.session_id] = [lineDatasetIndex];
      
      // 対応する動画操作マーカーをまとめて追加（セッションデータから）
      if (session.video_operations && (session.video_operations.skip?.length || session.video_operations.pause?.length || session.video_operations.other?.length)) {
        console.log(`🔧 [操作マーカー] セッション ${session.session_id}:`, session.video_operations);
        
        const allOperations = [];
        
        // スキップ/シークマーカー（三角形、紫）
        if (session.video_operations.skip && session.video_operations.skip.length > 0) {
          console.log(`  ✓ skip: ${session.video_operations.skip.length}件`);
          session.video_operations.skip.forEach(point => {
            allOperations.push({ x: point.time, y: point.video_time || 0, style: 'triangle', type: 'スキップ', color: '#6f42c1' });
          });
        }
        
        // 一時停止マーカー（四角形、紫）
        if (session.video_operations.pause && session.video_operations.pause.length > 0) {
          console.log(`  ✓ pause: ${session.video_operations.pause.length}件`);
          session.video_operations.pause.forEach(point => {
            allOperations.push({ x: point.time, y: point.video_time || 0, style: 'rect', type: '一時停止', color: '#6f42c1' });
          });
        }
        
        // その他の操作マーカー（円形、紫）
        if (session.video_operations.other && session.video_operations.other.length > 0) {
          console.log(`  ✓ other: ${session.video_operations.other.length}件`);
          session.video_operations.other.forEach(point => {
            allOperations.push({ x: point.time, y: point.video_time || 0, style: 'circle', type: 'その他の操作', color: '#6f42c1' });
          });
        }
        
        // すべての操作を1つのデータセットとして追加
        if (allOperations.length > 0) {
          sessionDatasetGroups[session.session_id].push(datasets.length);
          datasets.push({
            label: `${session.label} - 操作マーカー（紫）`,
            data: allOperations,
            backgroundColor: allOperations.map(o => o.color),
            borderColor: allOperations.map(o => o.color),
            pointRadius: 6,
            pointHoverRadius: 8,
            pointStyle: function(context) {
              const point = context.raw;
              if (!point) return 'circle';
              return point.style || 'circle';
            },
            showLine: false,
            order: 1,
            sessionId: session.session_id
          });
        }
      }
      
      // 対応する動画操作マーカーをまとめて追加（外部データから検索：後方互換性）
      const ops = videoOperationsMarkers.find(o => o.session_id === session.session_id);
      if (ops) {
        // すべての操作マーカーを1つの配列にまとめる
        const allOperations = [];
        
        // スキップ/シークマーカー（三角形）
        if (ops.skip && ops.skip.length > 0) {
          ops.skip.forEach(point => {
            allOperations.push({ ...point, style: 'triangle', type: 'スキップ' });
          });
        }
        
        // 一時停止マーカー（四角形）
        if (ops.pause && ops.pause.length > 0) {
          ops.pause.forEach(point => {
            allOperations.push({ ...point, style: 'rect', type: '一時停止' });
          });
        }
        
        // その他の操作マーカー（円形）
        if (ops.other && ops.other.length > 0) {
          ops.other.forEach(point => {
            allOperations.push({ ...point, style: 'circle', type: 'その他' });
          });
        }
        
        // すべての操作を1つのデータセットとして追加
        if (allOperations.length > 0) {
          sessionDatasetGroups[session.session_id].push(datasets.length);
          datasets.push({
            label: `${ops.label} - 操作`,
            data: allOperations,
            backgroundColor: operationColor,
            borderColor: operationColor,
            pointRadius: 3,
            pointHoverRadius: 5,
            pointStyle: function(context) {
              const point = context.raw;
              if (!point) return 'circle';
              return point.style || 'circle';
            },
            showLine: false,
            order: 1,
            sessionId: session.session_id
          });
        }
      }
      
      // 反応速度マーカーを追加（セッションデータに含まれる場合）
      if (session.response_markers && (session.response_markers.quick?.length || session.response_markers.normal?.length || session.response_markers.slow?.length)) {
        console.log(`📍 [反応速度マーカー] セッション ${session.session_id}:`, session.response_markers);
        
        const allResponses = [];
        
        // 素早い回答マーカー（上向き三角▲、ピンク）
        if (session.response_markers.quick && session.response_markers.quick.length > 0) {
          console.log(`  ✓ quick: ${session.response_markers.quick.length}件`);
          session.response_markers.quick.forEach(point => {
            allResponses.push({ x: point.time, y: point.video_time || 0, style: 'triangle', type: '素早い回答', color: '#ff65B2' });
          });
        }
        
        // 通常の回答速度マーカー（円形○、濃いピンク）
        if (session.response_markers.normal && session.response_markers.normal.length > 0) {
          console.log(`  ✓ normal: ${session.response_markers.normal.length}件`);
          session.response_markers.normal.forEach(point => {
            allResponses.push({ x: point.time, y: point.video_time || 0, style: 'circle', type: '回答速度普通', color: '#ff007F' });
          });
        }
        
        // 回答遅延マーカー（下向き三角▼、深い紫紅）
        if (session.response_markers.slow && session.response_markers.slow.length > 0) {
          console.log(`  ✓ slow: ${session.response_markers.slow.length}件`);
          session.response_markers.slow.forEach(point => {
            allResponses.push({ x: point.time, y: point.video_time || 0, style: 'rectRot', type: '回答遅延', color: '#98004c' });
          });
        }
        
        // 反応速度マーカーをデータセットに追加
        if (allResponses.length > 0) {
          sessionDatasetGroups[session.session_id].push(datasets.length);
          datasets.push({
            label: `${session.label} - 反応速度`,
            data: allResponses,
            backgroundColor: allResponses.map(r => r.color),
            borderColor: allResponses.map(r => r.color),
            pointRadius: 8,
            pointHoverRadius: 10,
            pointStyle: function(context) {
              const point = context.raw;
              if (!point) return 'circle';
              return point.style || 'circle';
            },
            showLine: false,
            order: 0,
            sessionId: session.session_id
          });
        }
      }
      
      // 反応速度マーカーを追加（外部データから検索：後方互換性）
      const resp = responseTimeMarkers.find(r => r.session_id === session.session_id);
      console.log(`[反応速度デバッグ] セッション ${session.session_id} のマーカー検索結果:`, resp);
      if (resp) {
        const allResponses = [];
        
        // 素早い回答マーカー（上向き三角▲、薄いピンク）
        if (resp.quick && resp.quick.length > 0) {
          console.log(`[反応速度デバッグ] セッション ${session.session_id}: quick=${resp.quick.length}件追加`);
          resp.quick.forEach(point => {
            allResponses.push({ ...point, style: 'triangle', type: '素早い回答', color: responseQuickColor });
          });
        }
        
        // 通常の回答速度マーカー（円形○、ピンク）
        if (resp.normal && resp.normal.length > 0) {
          console.log(`[反応速度デバッグ] セッション ${session.session_id}: normal=${resp.normal.length}件追加`);
          resp.normal.forEach(point => {
            allResponses.push({ ...point, style: 'circle', type: '回答速度普通', color: responseNormalColor });
          });
        }
        
        // 回答遅延マーカー（下向き三角▼、薄暗いピンク）
        if (resp.slow && resp.slow.length > 0) {
          console.log(`[反応速度デバッグ] セッション ${session.session_id}: slow=${resp.slow.length}件追加`);
          resp.slow.forEach(point => {
            allResponses.push({ ...point, style: 'rectRot', type: '回答遅延', color: responseSlowColor });
          });
        }
        
        // 速い問題確認マーカー（星型★、水色）
        if (resp.quick_check && resp.quick_check.length > 0) {
          console.log(`[速い問題確認デバッグ] セッション ${session.session_id}: quick_check=${resp.quick_check.length}件追加`);
          resp.quick_check.forEach(point => {
            allResponses.push({ ...point, style: 'star', type: '速い問題確認', color: quickCheckColor });
          });
        }
        
        console.log(`[反応速度デバッグ] セッション ${session.session_id}: 合計 ${allResponses.length}件の反応速度マーカー`)
        
        if (allResponses.length > 0) {
          console.log(`[反応速度デバッグ] セッション ${session.session_id}: データセット追加 (${allResponses.length}件)`, allResponses);
          sessionDatasetGroups[session.session_id].push(datasets.length);
          const responseDataset = {
            label: `${resp.label} - 反応速度`,
            data: allResponses,
            pointRadius: 9,
            pointHoverRadius: 11,
            pointStyle: function(context) {
              const point = context.raw;
              if (!point) return 'circle';
              return point.style || 'circle';
            },
            pointBackgroundColor: function(context) {
              const point = context.raw;
              if (!point) return responseNormalColor;
              return point.color || responseNormalColor;
            },
            pointBorderColor: function(context) {
              const point = context.raw;
              if (!point) return responseNormalColor;
              return point.color || responseNormalColor;
            },
            showLine: false,
            order: 1,
            sessionId: session.session_id
          };
          datasets.push(responseDataset);
          console.log(`[反応速度デバッグ] データセット追加完了:`, responseDataset);
        } else {
          console.log(`[反応速度デバッグ] セッション ${session.session_id}: マーカーが0件のためスキップ`);
        }
      } else {
        console.log(`[反応速度デバッグ] セッション ${session.session_id}: マーカーデータが見つかりません`);
      }
    });

    // オリジナルデータを深いコピーで保存（フィルタリング前の状態）
    originalScoreTimelineDatasets = JSON.parse(JSON.stringify(datasets));
    
    // Chart を初期化（try-catchで例外をキャッチ）
    try {
      chartInstances.scoreTimeline = new Chart(scoreTimelineCtx, {
        type: 'scatter',
        data: { datasets },
      options: {
        ...commonOptions,
        scales: {
          x: {
            type: 'linear',
            title: {
              display: true,
              text: 'セッション経過時間（秒）'
            },
            ticks: {
              callback: function(value) {
                const minutes = Math.floor(value / 60);
                const seconds = Math.floor(value % 60);
                return `${minutes}:${seconds.toString().padStart(2, '0')}`;
              }
            }
          },
          y: {
            type: 'linear',
            title: {
              display: true,
              text: '動画再生時間（秒）'
            },
            ticks: {
              callback: function(value) {
                const minutes = Math.floor(value / 60);
                const seconds = Math.floor(value % 60);
                return `${minutes}:${seconds.toString().padStart(2, '0')}`;
              }
            },
            beginAtZero: true
          }
        },
        plugins: {
          ...commonOptions.plugins,
          zoom: {
            zoom: {
              wheel: {
                enabled: true,
              },
              pinch: {
                enabled: true
              },
              mode: 'xy',
            },
            pan: {
              enabled: true,
              mode: 'xy',
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const point = context.raw;
                const videoMinutes = Math.floor(context.parsed.y / 60);
                const videoSeconds = Math.floor(context.parsed.y % 60);
                
                // 動画操作マーカーの場合
                if (context.dataset.label.includes('操作')) {
                  const operationType = point.type || '操作';
                  return `${operationType} | 動画: ${videoMinutes}:${videoSeconds.toString().padStart(2, '0')}${point.description ? ' - ' + point.description : ''}`;
                }
                
                // 反応速度マーカーの場合
                if (context.dataset.label.includes('反応速度')) {
                  const responseType = point.type || '反応';
                  
                  // 速い問題確認の場合は視線速度データを表示
                  if (point.type === '速い問題確認' && point.details) {
                    const gazeVelocityX = point.details.gazeVelocityX || 'N/A';
                    const gazeVelocityY = point.details.gazeVelocityY || 'N/A';
                    const threshold = point.details.threshold || 5;
                    const timeFromQuestion = point.details.timeFromQuestion || 'N/A';
                    return [
                      `${responseType} | 動画: ${videoMinutes}:${videoSeconds.toString().padStart(2, '0')}`,
                      `視線速度X: ${gazeVelocityX} px/s (閾値: ${threshold} px/s)`,
                      `視線速度Y: ${gazeVelocityY} px/s`,
                      `問題表示から: ${timeFromQuestion} 秒`
                    ];
                  }
                  
                  // その他の反応速度マーカー
                  const responseTime = point.response_time ? ` (${point.response_time.toFixed(1)}秒)` : '';
                  return `${responseType}${responseTime} | 動画: ${videoMinutes}:${videoSeconds.toString().padStart(2, '0')}${point.description ? ' - ' + point.description : ''}`;
                }
                
                // 集中スコアラインの場合
                const score = point.score !== undefined ? point.score : 0;
                return `${context.dataset.label} - 集中度: ${score.toFixed(1)}点 | 動画: ${videoMinutes}:${videoSeconds.toString().padStart(2, '0')}`;
              },
              title: function(context) {
                const minutes = Math.floor(context[0].parsed.x / 60);
                const seconds = Math.floor(context[0].parsed.x % 60);
                return `経過時間: ${minutes}:${seconds.toString().padStart(2, '0')}`;
              }
            }
          }
        }
      }
    });
    } catch (chartError) {
      console.error('[scoreTimeline] チャート作成エラー:', chartError);
      // チャート作成に失敗した場合は、このセッションはスキップ
    }
    
    // 以下のコードはチャート作成成功時のみ実行
    if (chartInstances.scoreTimeline) {
      // マーカーホバー時に同じセッションのラインの色を変更
      let currentHoveredSessionId = null;
      
      chartInstances.scoreTimeline.options.onHover = function(event, activeElements) {
        if (activeElements.length > 0) {
          const hoveredDatasetIndex = activeElements[0].datasetIndex;
          const hoveredDataset = this.data.datasets[hoveredDatasetIndex];
          const hoveredSessionId = hoveredDataset.sessionId;
          
          // 既に同じセッションをホバー中なら何もしない
          if (currentHoveredSessionId === hoveredSessionId) {
            return;
          }
          
          currentHoveredSessionId = hoveredSessionId;
          
          // すべてのラインを元の色に戻してから、ホバー中のセッションのラインを青色に
          this.data.datasets.forEach((dataset) => {
            if (dataset.showLine) {
              if (dataset.sessionId === hoveredSessionId) {
                dataset.borderColor = 'rgba(54, 162, 235, 0.8)'; // 青色
                dataset.borderWidth = 3;
              } else {
                dataset.borderColor = lineColor;
                dataset.borderWidth = 2;
              }
            }
          });
          
          this.update('none'); // アニメーションなしで更新
        } else {
          // ホバーが外れた場合は元の色に戻す
          if (currentHoveredSessionId !== null) {
            currentHoveredSessionId = null;
            
            this.data.datasets.forEach((dataset) => {
              if (dataset.showLine) {
                dataset.borderColor = lineColor;
                dataset.borderWidth = 2;
              }
            });
            
            this.update('none');
          }
        }
      };
      
      // セッション切り替えトグルを作成
      createSessionToggles('scoreTimeline', scoreTimelineData);

      // スライダーの max をデータの最大経過時間に合わせて初期化
      (function() {
        var maxSec = 0;
        scoreTimelineData.forEach(function(s) {
          (s.data || []).forEach(function(p) { if ((p.x || 0) > maxSec) maxSec = p.x; });
        });
        var maxMin = Math.max(Math.ceil(maxSec / 60), 10);
        var slider  = document.getElementById('xAxisMaxSlider');
        var display = document.getElementById('xAxisMaxDisplay');
        if (slider) {
          slider.max   = Math.max(maxMin, parseInt(slider.max, 10));
          slider.value = maxMin;
          if (display) display.textContent = maxMin + ' 分';
        }
      })();

      // ダブルクリックでズームリセット
      scoreTimelineCtx.ondblclick = function() {
        chartInstances.scoreTimeline.resetZoom();
      };

      // シングルクリックでセッション選択ポップアップ
      (function() {
        var popup   = document.getElementById('scoreTimelinePopup');
        var lastClickTime = 0;

        scoreTimelineCtx.addEventListener('click', function(event) {
          // ダブルクリック判定（300ms以内の2回目クリックは無視）
          var now = Date.now();
          if (now - lastClickTime < 300) { lastClickTime = 0; return; }
          lastClickTime = now;

          var chart = chartInstances.scoreTimeline;
          if (!chart) return;

          // クリック座標に最も近いデータセットを取得
          var elements = chart.getElementsAtEventForMode(event, 'nearest', { intersect: false }, true);
          if (!elements.length) { popup.style.display = 'none'; return; }

          var ds = chart.data.datasets[elements[0].datasetIndex];
          if (!ds || !ds.sessionId) return;

          var sessionId = ds.sessionId;

          // セッション情報（scoreTimelineData から補足）
          var sessionInfo = (window.scoreTimelineData || []).find(function(s) {
            return s.session_id === sessionId;
          });

          document.getElementById('stPopupLabel').textContent = ds.label || ('セッション ' + sessionId);
          document.getElementById('stPopupInfo').textContent  =
            sessionInfo && sessionInfo.user_email
              ? sessionInfo.user_email + ' (ID: ' + sessionId + ')'
              : 'セッションID: ' + sessionId;
          document.getElementById('stPopupEditLink').href =
            '/videos/' + videoIdGlobal + '/management/session/' + sessionId + '/events';
          document.getElementById('stPopupDeleteBtn').dataset.sessionId = sessionId;

          // ポップアップ位置をクリック点に合わせる
          var container = scoreTimelineCtx.parentElement;
          var canvasRect    = scoreTimelineCtx.getBoundingClientRect();
          var containerRect = container.getBoundingClientRect();
          var x = event.clientX - containerRect.left + 12;
          var y = event.clientY - containerRect.top  + 12;
          // 右端・下端からはみ出す場合に補正
          if (x + 240 > container.offsetWidth)  x = container.offsetWidth  - 244;
          if (y + 110 > container.offsetHeight) y = event.clientY - containerRect.top - 120;

          popup.style.left    = x + 'px';
          popup.style.top     = y + 'px';
          popup.style.display = 'block';
        });

        // セッション削除ボタン
        document.getElementById('stPopupDeleteBtn').addEventListener('click', function() {
          var sid = this.dataset.sessionId;
          if (!sid) return;
          if (!confirm('セッション ID:' + sid + ' を削除してもよろしいですか？\nこの操作は取り消せません。')) return;

          var url  = '/videos/' + videoIdGlobal + '/management/session/' + sid;
          var csrf = document.querySelector('meta[name="csrf-token"]');
          fetch(url, {
            method: 'DELETE',
            headers: {
              'X-CSRF-Token': csrf ? csrf.content : '',
              'Accept': 'application/json'
            }
          }).then(function(res) {
            return res.json().then(function(body) {
              if (res.ok && body.success) {
                window.location.href = '<%= video_management_analytics_path(video_id: @video) %>';
              } else {
                alert('削除に失敗しました: ' + (body.error || res.status));
              }
            });
          }).catch(function() {
            alert('削除リクエストの送信に失敗しました。');
          });
        });

        // チャートの外をクリックしたらポップアップを閉じる
        document.addEventListener('click', function(e) {
          if (!popup.contains(e.target) && e.target !== scoreTimelineCtx) {
            popup.style.display = 'none';
          }
        }, { capture: true });
      })();
    }
    isInitializingCharts = false;
    })  // fetch の .then() コールバック終了
    .catch(error => {
      // AbortError（キャンセル）の場合はログを少なめに
      if (error.name === 'AbortError') {
        console.log('[scoreTimeline] AJAX がキャンセルされました（新しい初期化が開始されたため）');
      } else {
        console.error('[scoreTimeline] AJAX エラー:', error);
      }
      isInitializingCharts = false;
      chartsInitialized = true;
    });
  }

  // その他のチャートは従来の ERB inline JSON で初期化される

  // 4. ユーザー別平均スコアグラフ
  const userScoresCtx = document.getElementById('userScoresChart');
  if (userScoresCtx) {
    const userData = <%= raw @user_score_data.to_json %>;
    
    if (userData && userData.labels && userData.values && userData.labels.length > 0) {
      chartInstances.userScores = new Chart(userScoresCtx, {
      type: 'bar',
      data: {
        labels: userData.labels,
        datasets: [{
          label: '平均スコア',
          data: userData.values,
          backgroundColor: userData.values.map(score => {
            if (score >= 70) return 'rgba(40, 167, 69, 0.8)';
            if (score >= 50) return 'rgba(255, 193, 7, 0.8)';
            return 'rgba(220, 53, 69, 0.8)';
          }),
          borderWidth: 1
        }]
      },
      options: {
        indexAxis: 'y',
        ...commonOptions,
        scales: {
          x: {
            title: {
              display: true,
              text: '平均集中スコア'
            },
            beginAtZero: true,
            max: 100
          },
          y: {
            title: {
              display: true,
              text: 'ユーザー'
            }
          }
        },
        plugins: {
          ...commonOptions.plugins,
          tooltip: {
            callbacks: {
              label: function(context) {
                const index = context.dataIndex;
                const score = context.parsed.x.toFixed(1);
                const sessions = userData.counts[index];
                return [
                  '平均スコア: ' + score + '点',
                  'セッション数: ' + sessions + '回'
                ];
              }
            }
          }
        }
      }
    });
    } else {
      console.warn('[userScores] データが利用できません:', userData);
    }
  }

  // 5. 動画時間別イベント密度グラフ
  const videoDensityCtx = document.getElementById('videoDensityChart');
  if (videoDensityCtx) {
    const densityData = <%= raw @video_time_density_data.to_json %>;
    
    if (densityData && Array.isArray(densityData) && densityData.length > 0) {
      chartInstances.videoDensity = new Chart(videoDensityCtx, {
      type: 'bar',
      data: {
        labels: densityData.map(d => d.label),
        datasets: [{
          label: 'イベント数',
          data: densityData.map(d => d.y),
          backgroundColor: 'rgba(255, 99, 132, 0.8)',
          borderColor: 'rgba(255, 99, 132, 1)',
          borderWidth: 1
        }]
      },
      options: {
        ...commonOptions,
        scales: {
          x: {
            title: {
              display: true,
              text: '動画時間（30秒単位）'
            }
          },
          y: {
            title: {
              display: true,
              text: 'イベント数'
            },
            beginAtZero: true,
            ticks: {
              stepSize: 1
            }
          }
        },
        plugins: {
          ...commonOptions.plugins,
          zoom: {
            zoom: {
              wheel: {
                enabled: true,
              },
              pinch: {
                enabled: true
              },
              mode: 'xy',
            },
            pan: {
              enabled: true,
              mode: 'xy',
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                return 'イベント数: ' + context.parsed.y + '件';
              }
            }
          }
        }
      }
      });
    } else {
      console.warn('[videoDensity] データが利用できません:', densityData);
    }
    
    // ダブルクリックでズームリセット
    if (chartInstances.videoDensity) {
      videoDensityCtx.ondblclick = function() {
        chartInstances.videoDensity.resetZoom();
      };
    }
  }

  // 6. 動画操作マップ（全体）
  const videoOperationsCtx = document.getElementById('videoOperationsChart');
  if (videoOperationsCtx) {
    const operationsData = <%= raw @video_operations_map_data.to_json %>;
    
    // 元データを保存（分割数変更用）
    originalOperationsMapData = JSON.parse(JSON.stringify(operationsData));
    
    chartInstances.videoOperations = new Chart(videoOperationsCtx, {
      type: 'bar',
      data: {
        labels: operationsData.map(d => d.label),
        datasets: [
          {
            label: '一時停止',
            data: operationsData.map(d => d.pause),
            backgroundColor: 'rgba(255, 193, 7, 0.8)',
            borderColor: 'rgba(255, 193, 7, 1)',
            borderWidth: 1
          },
          {
            label: 'スキップ/シーク',
            data: operationsData.map(d => d.seek),
            backgroundColor: 'rgba(220, 53, 69, 0.8)',
            borderColor: 'rgba(220, 53, 69, 1)',
            borderWidth: 1
          },
          {
            label: '問題回答',
            data: operationsData.map(d => d.response || 0),
            backgroundColor: 'rgba(13, 110, 253, 0.8)',
            borderColor: 'rgba(13, 110, 253, 1)',
            borderWidth: 1
          }
        ]
      },
      options: {
        ...commonOptions,
        scales: {
          x: {
            title: {
              display: true,
              text: '動画時間'
            },
            ticks: {
              maxRotation: 45,
              minRotation: 45
            }
          },
          y: {
            title: {
              display: true,
              text: '操作回数'
            },
            beginAtZero: true,
            ticks: {
              stepSize: 1
            }
          }
        },
        plugins: {
          ...commonOptions.plugins,
          zoom: {
            zoom: {
              wheel: {
                enabled: true,
              },
              pinch: {
                enabled: true
              },
              mode: 'xy',
            },
            pan: {
              enabled: true,
              mode: 'xy',
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': ' + context.parsed.y + '回';
              },
              footer: function(context) {
                const index = context[0].dataIndex;
                const total = operationsData[index].total;
                return '合計: ' + total + '回';
              }
            }
          }
        }
      }
    });
    
    videoOperationsCtx.ondblclick = function() {
      chartInstances.videoOperations.resetZoom();
    };
  }

  // 7. ユーザー別動画操作
  const userOperationsCtx = document.getElementById('userOperationsChart');
  if (userOperationsCtx) {
    const userOpsData = <%= raw @user_operations_map_data.to_json %>;
    
    const colors = [
      'rgba(255, 99, 132, 0.6)',
      'rgba(54, 162, 235, 0.6)',
      'rgba(255, 206, 86, 0.6)',
      'rgba(75, 192, 192, 0.6)',
      'rgba(153, 102, 255, 0.6)',
      'rgba(255, 159, 64, 0.6)',
      'rgba(199, 199, 199, 0.6)',
      'rgba(83, 102, 255, 0.6)'
    ];
    
    chartInstances.userOperations = new Chart(userOperationsCtx, {
      type: 'scatter',
      data: {
        datasets: userOpsData.map((session, index) => ({
          label: session.label,
          data: session.data,
          backgroundColor: colors[index % colors.length],
          borderColor: colors[index % colors.length].replace('0.6', '1'),
          pointRadius: function(context) {
            const point = context.raw;
            return 3 + (point.y * 2); // 操作回数に応じてポイントサイズを変更
          },
          pointHoverRadius: function(context) {
            const point = context.raw;
            return 5 + (point.y * 2);
          }
        }))
      },
      options: {
        ...commonOptions,
        scales: {
          x: {
            type: 'linear',
            title: {
              display: true,
              text: '動画時間（秒）'
            },
            ticks: {
              callback: function(value) {
                const minutes = Math.floor(value / 60);
                const seconds = value % 60;
                return minutes + ':' + seconds.toString().padStart(2, '0');
              }
            }
          },
          y: {
            title: {
              display: true,
              text: '操作回数'
            },
            beginAtZero: true,
            ticks: {
              stepSize: 1
            }
          }
        },
        plugins: {
          ...commonOptions.plugins,
          zoom: {
            zoom: {
              wheel: {
                enabled: true,
              },
              pinch: {
                enabled: true
              },
              mode: 'xy',
            },
            pan: {
              enabled: true,
              mode: 'xy',
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const point = context.raw;
                const minutes = Math.floor(point.x / 60);
                const seconds = Math.floor(point.x % 60);
                return [
                  context.dataset.label,
                  `動画時間: ${minutes}:${seconds.toString().padStart(2, '0')}`,
                  `操作回数: ${point.y}回`,
                  `  一時停止: ${point.pause}回`,
                  `  スキップ: ${point.seek}回`
                ];
              }
            }
          }
        }
      }
    });
    
    // セッション切り替えトグルを作成
    createSessionToggles('userOperations', userOpsData);
    
    userOperationsCtx.ondblclick = function() {
      chartInstances.userOperations.resetZoom();
    };
  }
  
  // 初期化完了フラグをセット（isInitializingChartsはscoreTimeline AJAXの完了後にリセット）
  chartsInitialized = true;
  console.log('[グラフ初期化] すべてのチャート初期化完了');
  
  // 他のチャートも初期化
  initializeOtherCharts(chartsData);
}

// ユーザー分類グラフの初期化
function initializeUserClassificationChart() {
  if (typeof Chart === 'undefined') {
    setTimeout(initializeUserClassificationChart, 100);
    return;
  }
  
  const ctx = document.getElementById('userClassificationChart');
  if (!ctx) return;
  
  // 既存チャートを破棄
  if (chartInstances.userClassification) {
    chartInstances.userClassification.destroy();
  }
  
  // AJAX で response_data を取得
  const videoId = <%= @video.id %>;
  
  Promise.all([
    // scoreTimelineData が未ロードの場合は全ページ fetch
    window.scoreTimelineData ? Promise.resolve(window.scoreTimelineData) :
      fetch(`/video_management/get_chart_data?video_id=${videoId}&chart_type=score_timeline&session_page=0`)
        .then(response => {
          if (!response.ok) throw new Error(`HTTP ${response.status} from scoreTimeline fetch`);
          return response.json();
        })
        .then(result => {
          console.log('[分類グラフ初期化] scoreTimeline ページ1取得:', result.pagination);
          if (result.pagination && result.pagination.has_next) {
            return loadUcScoreTimelineChunks(result.data || [], result.pagination, videoId);
          }
          return result.data || [];
        })
        .catch(error => {
          console.error('[分類グラフ初期化] scoreTimeline AJAX エラー:', error);
          return [];
        }),
    // responseData を fetch（チャンク読 込対応）
    fetch(`/video_management/get_chart_data?video_id=${videoId}&chart_type=response_data&response_page=0`)
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status} from response_data fetch`);
        return response.json();
      })
      .then(result => {
        console.log('[分類グラフ初期化] responseData 取得（ページ 1）:', result.pagination);
        // チャンク読 込対応：複数ページを統合
        if (result.pagination && result.pagination.has_next) {
          return loadResponseDataChunks(result.data || [], result.pagination, videoId);
        }
        return result.data || [];
      })
      .catch(error => {
        console.error('[分類グラフ初期化] responseData AJAX エラー:', error);
        return [];  // エラー時は空配列を返す
      })
  ])
  .then(([scoreTimelineData, responseData]) => {
    window.scoreTimelineData = scoreTimelineData;
    window.responseData = responseData;
    
    console.log('[分類グラフ初期化] データ AJAX 取得完了:', {
      scoreTimelineDataLength: scoreTimelineData.length,
      responseDataLength: responseData.length,
      scoreTimelineData: scoreTimelineData.slice(0, 2),
      responseData: responseData.slice(0, 2)
    });
    
    initializeUserClassificationChartInternal(ctx, scoreTimelineData, responseData);
  })
  .catch(error => {
    console.error('[分類グラフ初期化] AJAX エラー:', error);
    alert('ユーザー分類グラフのデータ取得に失敗しました: ' + error.message);
  });
}

// ユーザー分類グラフ初期化の本体
function initializeUserClassificationChartInternal(ctx, scoreTimelineData, responseData) {
  console.log('[分類グラフ初期化] responseData:', {
    型: typeof responseData,
    isArray: Array.isArray(responseData),
    長さ: responseData ? responseData.length : 'null',
    最初の要素: responseData && responseData[0] ? responseData[0] : 'なし',
    JSON文字列: JSON.stringify(responseData).substring(0, 500)
  });
  
  // 既存のチャートインスタンスがあれば破棄
  if (chartInstances.userClassification) {
    try {
      chartInstances.userClassification.destroy();
      chartInstances.userClassification = null;
    } catch (e) {
      console.warn('[分類グラフ] 既存チャートの破棄エラー:', e.message);
    }
  }
  
  // ユーザー分類を保持するオブジェクト
  window.userClassifications = {
    groupA: [],
    groupB: [],
    groupC: [],
    groupD: []
  };
  
  // ユーザーIDとセッションIDのマッピング
  window.sessionUserMap = {};
  scoreTimelineData.forEach(session => {
    window.sessionUserMap[session.session_id] = {
      user_id: session.user_id,
      label: session.label
    };
  });
  
  // デフォルトカラー定義（グループごと）
  const groupColors = {
    groupA: 'rgba(13, 110, 253, 0.6)',   // 青
    groupB: 'rgba(40, 167, 69, 0.6)',    // 緑
    groupC: 'rgba(255, 193, 7, 0.6)',    // 黄
    groupD: 'rgba(220, 53, 69, 0.6)'     // 赤
  };
  
  const lineColor = 'rgba(128, 128, 128, 0.3)'; // グレー（未分類）
  
  // グラフ用のデータセットを作成
  const datasets = [];
  
  scoreTimelineData.forEach((session, sessionIndex) => {
    const sessionData = session.data.map(point => ({
      x: point.x,
      y: point.video_time || 0,
      score: point.y,
      video_time: point.video_time,
      color: '#999'
    }));
    
    datasets.push({
      label: session.label,
      data: sessionData,
      borderColor: lineColor,
      borderWidth: 2,
      showLine: true,
      tension: 0,
      pointRadius: 2,
      pointHoverRadius: 5,
      pointBackgroundColor: '#999',
      pointBorderColor: '#999',
      order: 2,
      sessionId: session.session_id,
      userId: session.user_id,
      classification: null // 分類状態を保持
    });
  });
  
  // グラフを作成する前にcanvas要素が有効か確認
  if (!ctx) {
    const canvasElement = document.getElementById('userClassificationChart');
    if (!canvasElement) {
      console.warn('[分類グラフ] Canvas要素が見つかりません');
      return;
    }
    ctx = canvasElement.getContext('2d');
  }
  
  // グラフを作成
  chartInstances.userClassification = new Chart(ctx, {
    type: 'scatter',
    data: { datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        x: {
          type: 'linear',
          title: {
            display: true,
            text: 'セッション経過時間（秒）'
          },
          ticks: {
            callback: function(value) {
              const minutes = Math.floor(value / 60);
              const seconds = Math.floor(value % 60);
              return `${minutes}:${seconds.toString().padStart(2, '0')}`;
            }
          }
        },
        y: {
          type: 'linear',
          title: {
            display: true,
            text: '動画再生時間（秒）'
          },
          ticks: {
            callback: function(value) {
              const minutes = Math.floor(value / 60);
              const seconds = Math.floor(value % 60);
              return `${minutes}:${seconds.toString().padStart(2, '0')}`;
            }
          }
        }
      },
      plugins: {
        legend: {
          display: true,
          position: 'top'
        },
        zoom: {
          zoom: {
            wheel: {
              enabled: true,
            },
            pinch: {
              enabled: true
            },
            mode: 'xy',
          },
          pan: {
            enabled: true,
            mode: 'xy',
          },
          limits: {
            x: {min: 'original', max: 'original'},
            y: {min: 'original', max: 'original'}
          }
        }
      }
    }
  });
  
  // クリックイベントを登録
  const canvasElement = ctx.canvas || document.getElementById('userClassificationChart');
  
  // ダブルクリック検出用
  let lastClickTime = 0;
  let doubleClickResetActive = false;
  
  canvasElement.addEventListener('click', function(event) {
    const currentTime = new Date().getTime();
    const timeDifference = currentTime - lastClickTime;
    
    // ダブルクリック判定（300ms以内）
    if (timeDifference < 300) {
      doubleClickResetActive = true;
      // ズームをリセット
      chartInstances.userClassification.resetZoom();
      console.log('[ユーザー分類] ズームをリセット');
    } else {
      doubleClickResetActive = false;
      // ダブルクリックではないので通常のセッション分類処理
      const points = chartInstances.userClassification.getElementsAtEventForMode(event, 'nearest', { intersect: true }, true);
      if (points.length > 0) {
        if (window.classificationMode === 'db') {
          classifyUserSessionDB(points[0].datasetIndex);
        } else {
          classifyUserSession(points[0].datasetIndex);
        }
      }
    }
    
    lastClickTime = currentTime;
  });
  
  // ローカルストレージから前回の分類データを読み込む
  const storageKey = `userClassification_video_${videoIdGlobal}`;
  const savedClassifications = localStorage.getItem(storageKey);
  
  if (savedClassifications) {
    try {
      const parsed = JSON.parse(savedClassifications);
      console.log('[ユーザー分類] ローカルストレージから分類データを読み込み:', parsed);
      
      // 保存されたデータを復元
      window.userClassifications = parsed;
      
      // グラフに反映
      Object.keys(parsed).forEach(group => {
        const sessionIds = parsed[group];
        const groupColors = {
          groupA: 'rgba(13, 110, 253, 0.8)',   // 青
          groupB: 'rgba(40, 167, 69, 0.8)',    // 緑
          groupC: 'rgba(255, 193, 7, 0.8)',    // 黄
          groupD: 'rgba(220, 53, 69, 0.8)'     // 赤
        };
        
        sessionIds.forEach(sessionId => {
          const dataset = chartInstances.userClassification.data.datasets.find(
            d => d.sessionId === sessionId
          );
          if (dataset) {
            dataset.classification = group;
            dataset.borderColor = groupColors[group];
            dataset.borderWidth = 3;
            dataset.pointBackgroundColor = groupColors[group];
            dataset.pointBorderColor = groupColors[group];
            dataset.pointRadius = 2;
          }
        });
      });
      
      chartInstances.userClassification.update('none');
      updateClassificationStats();
      console.log('[ユーザー分類] グラフに分類データを反映完了');
    } catch (error) {
      console.error('[ユーザー分類] ローカルストレージの読み込みエラー:', error);
    }
  } else {
    console.log('[ユーザー分類] 保存された分類データなし');
  }

  // DBに保存済みのグループをグラフに反映（dataset.dbGroup を設定しておく）
  loadInitialDbGroups();

  // 前回のモード設定を復元（localStorage に保存済みの場合）
  const savedMode = localStorage.getItem('classificationMode_video_' + videoIdGlobal);
  if (savedMode && savedMode !== window.classificationMode) {
    window.classificationMode = savedMode;
    // ラジオボタンを合わせる
    const radio = document.getElementById(savedMode === 'db' ? 'modeDb' : 'modeVisual');
    if (radio) radio.checked = true;
    // コントロール表示切り替えとグラフ再描画
    switchClassificationMode(savedMode);
  }

  // スライダーの max をデータの最大経過時間に合わせて初期化
  (function() {
    var maxSec = 0;
    (chartInstances.userClassification.data.datasets || []).forEach(function(ds) {
      (ds.data || []).forEach(function(p) { if ((p.x || 0) > maxSec) maxSec = p.x; });
    });
    var maxMin = Math.max(Math.ceil(maxSec / 60), 10);
    var slider  = document.getElementById('ucXAxisMaxSlider');
    var display = document.getElementById('ucXAxisMaxDisplay');
    if (slider) {
      slider.max   = Math.max(maxMin, parseInt(slider.max, 10));
      slider.value = maxMin;
      if (display) display.textContent = maxMin + ' 分';
    }
  })();

  // K-meansの結果をlocalStorageから復元
  (function() {
    var saved = localStorage.getItem('kmeansResult_video_' + videoIdGlobal);
    if (!saved) return;
    var data;
    try { data = JSON.parse(saved); } catch(e) {
      localStorage.removeItem('kmeansResult_video_' + videoIdGlobal);
      return;
    }
    if (!data || !Array.isArray(data.clusters) || !Array.isArray(data.session_assignments)) {
      localStorage.removeItem('kmeansResult_video_' + videoIdGlobal);
      return;
    }
    // 古いデータ（フィールド不足）を弾く: centroid に必須フィールドを確認
    var firstCentroid = data.clusters[0] && data.clusters[0].centroid;
    if (firstCentroid && (firstCentroid.effective_speed == null || firstCentroid.playing_speed == null)) {
      console.warn('[K-means] 古いデータ形式のため復元をスキップしました（再実行してください）');
      localStorage.removeItem('kmeansResult_video_' + videoIdGlobal);
      var msg = document.getElementById('kmeans-save-msg');
      if (msg) msg.textContent = '保存データが古い形式です。再度「実行」してください。';
      return;
    }
    window.kmeansResult = data;
    try {
      renderKmeansTable(data.clusters);
    } catch(e) {
      console.warn('[K-means] テーブル描画失敗:', e);
      localStorage.removeItem('kmeansResult_video_' + videoIdGlobal);
      window.kmeansResult = null;
      return;
    }
    document.getElementById('kmeans-result').style.display = 'block';
    var kInput = document.getElementById('kmeansK');
    if (kInput && data.clusters.length) kInput.value = data.clusters.length;
    try {
      previewKmeansClusters();
    } catch(e) {
      console.warn('[K-means] プレビュー失敗:', e);
    }
    console.log('[K-means] localStorage から結果を復元しました（クラスタ数:', data.clusters.length, '）');
  })();
}

// ユーザーをグループに分類
function classifyUserSession(datasetIndex) {
  const selectedGroup = document.querySelector('input[name="classificationGroup"]:checked').value;
  const dataset = chartInstances.userClassification.data.datasets[datasetIndex];
  
  if (!dataset) return;
  
  const sessionId = dataset.sessionId;
  const groupColors = {
    groupA: 'rgba(13, 110, 253, 0.8)',   // 青
    groupB: 'rgba(40, 167, 69, 0.8)',    // 緑
    groupC: 'rgba(255, 193, 7, 0.8)',    // 黄
    groupD: 'rgba(220, 53, 69, 0.8)'     // 赤
  };
  
  // 既に同じグループに分類されている場合は、分類を解除
  if (dataset.classification === selectedGroup) {
    console.log(`セッション ${sessionId} を ${selectedGroup} から削除しました`);
    
    // 分類を解除
    const index = window.userClassifications[selectedGroup].indexOf(sessionId);
    if (index > -1) {
      window.userClassifications[selectedGroup].splice(index, 1);
    }
    
    // グラフ表示をリセット
    dataset.classification = null;
    dataset.borderColor = 'rgba(128, 128, 128, 0.3)';
    dataset.borderWidth = 2;
    dataset.pointBackgroundColor = '#999';
    dataset.pointBorderColor = '#999';
    dataset.pointRadius = 2;
  } else {
    // 前の分類から外す
    if (dataset.classification) {
      const oldGroup = dataset.classification;
      const oldIndex = window.userClassifications[oldGroup].indexOf(sessionId);
      if (oldIndex > -1) {
        window.userClassifications[oldGroup].splice(oldIndex, 1);
      }
    }
    
    // 新しいグループに追加
    if (!window.userClassifications[selectedGroup].includes(sessionId)) {
      window.userClassifications[selectedGroup].push(sessionId);
    }
    
    // 分類状態を更新
    dataset.classification = selectedGroup;
    dataset.borderColor = groupColors[selectedGroup];
    dataset.borderWidth = 3;
    dataset.pointBackgroundColor = groupColors[selectedGroup];
    dataset.pointBorderColor = groupColors[selectedGroup];
    dataset.pointRadius = 3;
    
    console.log(`セッション ${sessionId} を ${selectedGroup} に分類しました`);
  }
  
  // チャート更新
  chartInstances.userClassification.update('none');

  // 統計を表示
  updateClassificationStats();

  // ローカルストレージに分類データを保存
  const storageKey = `userClassification_video_${videoIdGlobal}`;
  localStorage.setItem(storageKey, JSON.stringify(window.userClassifications));
  console.log('[ユーザー分類] ローカルストレージに分類データを保存:', window.userClassifications);

  // アクティブなフィルターを再適用
  if (ucActiveGroupFilter !== null) filterUcByGroup(ucActiveGroupFilter);
}

// ===== DBグループ分類 =====

// DBグループの色定義
const DB_GROUP_COLORS = {
  'normal':        'rgba(59, 130, 246, 0.9)',
  'fast_speed':    'rgba(139, 92, 246, 0.9)',
  'skip_heavy':    'rgba(245, 158, 11, 0.9)',
  'fast_and_skip': 'rgba(239, 68, 68, 0.9)',
  'too_short':     'rgba(236, 72, 153, 0.9)',
  'too_long':      'rgba(20, 184, 166, 0.9)'
};

function applyDbGroupColor(dataset, group) {
  if (group && DB_GROUP_COLORS[group]) {
    dataset.borderColor = DB_GROUP_COLORS[group];
    dataset.borderWidth = 3;
    dataset.pointBackgroundColor = DB_GROUP_COLORS[group];
    dataset.pointBorderColor = DB_GROUP_COLORS[group];
    dataset.pointRadius = 3;
  } else {
    dataset.borderColor = 'rgba(128,128,128,0.3)';
    dataset.borderWidth = 2;
    dataset.pointBackgroundColor = '#999';
    dataset.pointBorderColor = '#999';
    dataset.pointRadius = 2;
  }
  dataset.dbGroup = group || null;
}

// 初期化時に sessionGroupData（ERBで埋め込み済み）をグラフに反映
function loadInitialDbGroups() {
  if (!chartInstances.userClassification) return;
  chartInstances.userClassification.data.datasets.forEach(function(dataset) {
    const group = window.sessionGroupData[dataset.sessionId] || null;
    dataset.dbGroup = group;
    if (window.classificationMode === 'db') {
      applyDbGroupColor(dataset, group);
    }
  });
  if (window.classificationMode === 'db') {
    chartInstances.userClassification.update('none');
    updateDbClassificationStats();
  }
}

// セッションラインをDBグループに分類（クリック時）
function classifyUserSessionDB(datasetIndex) {
  const dataset = chartInstances.userClassification.data.datasets[datasetIndex];
  if (!dataset || !dataset.sessionId) return;

  const sessionId = dataset.sessionId;
  const checked = document.querySelector('input[name="dbClassificationGroup"]:checked');
  const selectedGroup = checked ? checked.value : null;

  // 同じグループを再クリックで解除
  const newGroup = (dataset.dbGroup === selectedGroup || !selectedGroup) ? null : selectedGroup;

  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
  const url = `/videos/${videoIdGlobal}/management/session/${sessionId}/group`;

  fetch(url, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
    body: JSON.stringify({ session_group: newGroup })
  })
  .then(r => r.json())
  .then(data => {
    if (data.ok) {
      window.sessionGroupData[sessionId] = newGroup;
      applyDbGroupColor(dataset, newGroup);
      chartInstances.userClassification.update('none');
      updateDbClassificationStats();
      console.log(`[DBグループ] セッション ${sessionId} → ${newGroup || '解除'}`);
      // アクティブなフィルターを再適用
      if (ucActiveDbFilter !== null) filterUcByDbGroup(ucActiveDbFilter);
    } else {
      alert('保存失敗: ' + (data.error || '不明なエラー'));
    }
  })
  .catch(() => alert('通信エラーが発生しました'));
}

// DBグループの集計バッジを更新
function updateDbClassificationStats() {
  const container = document.getElementById('db-classification-stats');
  if (!container) return;
  const SESSION_GROUP_LABELS = <%= raw LearningSession::SESSION_GROUPS.to_json %>;
  const counts = {};
  Object.values(window.sessionGroupData).forEach(function(g) {
    if (g) counts[g] = (counts[g] || 0) + 1;
  });
  const unset = Object.keys(window.sessionGroupData).length - Object.values(counts).reduce((a, b) => a + b, 0);
  let html = '';
  Object.entries(SESSION_GROUP_LABELS).forEach(function([key, label]) {
    const c = counts[key] || 0;
    const color = DB_GROUP_COLORS[key] || '#999';
    html += `<span class="badge rounded-pill" style="background:${color};font-size:0.78rem;">${label}: ${c}件</span>`;
  });
  if (unset > 0) html += `<span class="badge rounded-pill bg-secondary" style="font-size:0.78rem;">未分類: ${unset}件</span>`;
  container.innerHTML = html;
}

// DBグループ分類の詳細統計（カード形式）
function updateDbFullStats() {
  var container = document.getElementById('dbClassificationStats');
  if (!container) return;
  var responseData   = window.responseData  || [];
  var sessionUserMap = window.sessionUserMap || {};
  var totalQuestions = window.totalQuestions || 0;
  var useUniqueUsers = document.getElementById('countUniqueUsersToggle').checked;
  var SESSION_GROUP_LABELS = <%= raw LearningSession::SESSION_GROUPS.to_json %>;

  // グループ別にセッションIDを集める
  var groupSessions = {};
  Object.entries(SESSION_GROUP_LABELS).forEach(function([key]) { groupSessions[key] = []; });
  groupSessions['__unset__'] = [];

  Object.entries(window.sessionGroupData).forEach(function([sid, g]) {
    var key = g || '__unset__';
    if (!groupSessions[key]) groupSessions[key] = [];
    groupSessions[key].push(parseInt(sid, 10));
  });

  // scoreTimelineData にあるが sessionGroupData に含まれていないセッションも未分類に追加
  var knownSids = new Set(Object.keys(window.sessionGroupData).map(Number));
  (window.scoreTimelineData || []).forEach(function(s) {
    if (!knownSids.has(s.session_id)) {
      groupSessions['__unset__'].push(s.session_id);
    }
  });

  var allGroupKeys = Object.keys(SESSION_GROUP_LABELS).concat(['__unset__']);
  var html = '';

  allGroupKeys.forEach(function(groupKey) {
    var sessionIds = groupSessions[groupKey] || [];
    var label      = SESSION_GROUP_LABELS[groupKey] || '未分類';
    var color      = DB_GROUP_COLORS[groupKey] || '#6c757d';

    var memberCount, displayLabel;
    if (useUniqueUsers) {
      var uids = new Set(
        sessionIds.map(function(sid) {
          return sessionUserMap[sid] && sessionUserMap[sid].user_id;
        }).filter(Boolean)
      );
      memberCount  = uids.size;
      displayLabel = memberCount + '名（ユーザー数）';
    } else {
      memberCount  = sessionIds.length;
      displayLabel = memberCount + '件（セッション数）';
    }

    var groupResponses = responseData.filter(function(r) {
      return sessionIds.includes(r.session_id);
    });

    var cardBody;
    if (groupResponses.length === 0) {
      cardBody = '<p class="text-muted small mb-0">' +
                 'セッション: ' + displayLabel + '<br>回答なし</p>';
    } else {
      var total   = groupResponses.length;
      var correct = groupResponses.filter(function(r) { return r.correct; }).length;
      var correctRate = ((correct / total) * 100).toFixed(1);
      var avgTime = (groupResponses.reduce(function(s, r) { return s + (r.response_time || 0); }, 0) / total / 1000).toFixed(1);
      var avgPerMember = memberCount > 0 ? (total / memberCount).toFixed(1) : '-';
      var unitLabel = useUniqueUsers ? '回/ユーザー' : '回/セッション';
      var overallRate = (totalQuestions > 0 && memberCount > 0)
        ? ((correct / (totalQuestions * memberCount)) * 100).toFixed(1)
        : '-';

      cardBody = '<dl class="small mb-0">' +
        '<dt>セッション数</dt><dd>' + displayLabel + '</dd>' +
        '<dt>回答数</dt><dd>' + total + '件</dd>' +
        '<dt>平均回答数</dt><dd><strong>' + avgPerMember + unitLabel + '</strong></dd>' +
        '<dt>正答率</dt><dd><strong style="color:' + color + '">' + correctRate + '%</strong></dd>' +
        '<dt>全問正答率</dt><dd><strong style="color:' + color + '">' + overallRate + '%</strong></dd>' +
        '<dt>平均回答時間</dt><dd>' + avgTime + '秒</dd>' +
        '</dl>';
    }

    html += '<div class="col-md-6 col-lg-4 mb-3">' +
            '<div class="card h-100" style="border-left:4px solid ' + color + '">' +
            '<div class="card-body py-2 px-3">' +
            '<h6 class="card-title mb-2">' + label + '</h6>' +
            cardBody +
            '</div></div></div>';
  });

  container.innerHTML = html || '<p class="text-muted">DBグループが設定されていません</p>';
}

// ===== K-means 自動分類 =====

const KMEANS_CLUSTER_COLORS = [
  'rgba(59,130,246,0.85)',   // blue
  'rgba(239,68,68,0.85)',    // red
  'rgba(34,197,94,0.85)',    // green
  'rgba(234,179,8,0.85)',    // yellow
  'rgba(168,85,247,0.85)',   // purple
  'rgba(249,115,22,0.85)',   // orange
  'rgba(20,184,166,0.85)',   // teal
  'rgba(236,72,153,0.85)'    // pink
];

const SESSION_GROUP_LABELS_JS = <%= raw LearningSession::SESSION_GROUPS.to_json %>;

// クラスタリング実行
function runKmeans() {
  var k = parseInt(document.getElementById('kmeansK').value) || 6;
  var loadingEl = document.getElementById('kmeans-loading');
  var resultEl  = document.getElementById('kmeans-result');
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

  loadingEl.style.display = 'block';
  resultEl.style.display  = 'none';
  document.getElementById('kmeans-save-msg').textContent = '';

  var url = '<%= video_management_cluster_sessions_path(video_id: @video) %>?k=' + k;
  fetch(url, { headers: { 'X-CSRF-Token': csrfToken } })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      loadingEl.style.display = 'none';
      if (!data.ok) { alert('エラー: ' + (data.error || '不明')); return; }
      window.kmeansResult = data;
      localStorage.setItem('kmeansResult_video_' + videoIdGlobal, JSON.stringify(data));
      document.getElementById('kmeans-save-msg').textContent = '';
      renderKmeansTable(data.clusters);
      resultEl.style.display = 'block';
      previewKmeansClusters();
    })
    .catch(function() {
      loadingEl.style.display = 'none';
      alert('通信エラーが発生しました');
    });
}

// クラスターテーブルを描画
function renderKmeansTable(clusters) {
  var tbody = document.getElementById('kmeans-cluster-tbody');
  tbody.innerHTML = '';
  clusters.forEach(function(c) {
    var color = KMEANS_CLUSTER_COLORS[c.cluster_id % KMEANS_CLUSTER_COLORS.length];
    var sugLabel = SESSION_GROUP_LABELS_JS[c.suggested_group] || '未分類';
    var options = '<option value="">未分類</option>';
    Object.entries(SESSION_GROUP_LABELS_JS).forEach(function([key, label]) {
      var sel = key === c.suggested_group ? ' selected' : '';
      options += '<option value="' + key + '"' + sel + '>' + label + '</option>';
    });
    tbody.innerHTML += '<tr>' +
      '<td><span style="display:inline-block;width:16px;height:16px;border-radius:3px;background:' + color + ';"></span></td>' +
      '<td class="text-center">' + c.count + '件</td>' +
      '<td class="text-end">' + (+(c.centroid.effective_speed || 0)).toFixed(2) + 'x</td>' +
      '<td class="text-end">' + (+(c.centroid.playing_speed  || 0)).toFixed(2) + 'x</td>' +
      '<td class="text-end">' + ((+(c.centroid.skip_coverage || 0)) * 100).toFixed(1) + '%</td>' +
      '<td class="text-end">' + (+(c.centroid.duration_ratio  || 0)).toFixed(2) + '</td>' +
      '<td><span class="badge bg-secondary" style="font-size:0.75rem;">' + sugLabel + '</span></td>' +
      '<td><select class="form-select form-select-sm cluster-group-select" data-cluster-id="' + c.cluster_id + '"' +
        ' onchange="previewKmeansClusters()">' + options + '</select></td>' +
      '</tr>';
  });
}

// クラスター色をチャートにプレビュー
function previewKmeansClusters() {
  if (!window.kmeansResult || !chartInstances.userClassification) return;
  var assignments = {};
  window.kmeansResult.session_assignments.forEach(function(a) {
    assignments[a.session_id] = a.cluster_id;
  });
  chartInstances.userClassification.data.datasets.forEach(function(dataset) {
    var cid = assignments[dataset.sessionId];
    if (cid === undefined) return;
    var color = KMEANS_CLUSTER_COLORS[cid % KMEANS_CLUSTER_COLORS.length];
    dataset.borderColor          = color;
    dataset.borderWidth          = 3;
    dataset.pointBackgroundColor = color;
    dataset.pointBorderColor     = color;
    dataset.pointRadius          = 3;
  });
  chartInstances.userClassification.update('none');
}

// クラスター→グループ名マッピングを取得
function getClusterGroupMap() {
  var map = {};
  document.querySelectorAll('.cluster-group-select').forEach(function(sel) {
    map[parseInt(sel.dataset.clusterId)] = sel.value || null;
  });
  return map;
}

// DB に保存
function saveKmeansClusters(overwrite) {
  if (!window.kmeansResult) return;
  var clusterGroupMap = getClusterGroupMap();
  var assignments = {};
  window.kmeansResult.session_assignments.forEach(function(a) {
    var group = clusterGroupMap[a.cluster_id];
    if (!overwrite && a.current_group) return; // 未分類のみモード
    assignments[a.session_id] = group;
  });

  if (Object.keys(assignments).length === 0) {
    document.getElementById('kmeans-save-msg').textContent = '保存対象がありません（すべて分類済みです）';
    return;
  }

  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
  var url = '<%= video_management_bulk_update_groups_path(video_id: @video) %>';
  fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
    body: JSON.stringify({ assignments: assignments })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.ok) {
      // sessionGroupData を更新して DB カラー適用
      Object.assign(window.sessionGroupData, assignments);
      window.kmeansResult.session_assignments.forEach(function(a) {
        if (assignments[a.session_id] !== undefined) a.current_group = assignments[a.session_id];
      });
      var msg = document.getElementById('kmeans-save-msg');
      msg.textContent = data.updated + '件を保存しました（保存済みのためK-means結果をリセットします）';
      msg.className = 'mt-2 small text-success';
      // 保存完了後はlocalStorageのK-means結果を削除（次回は最新DBを反映）
      localStorage.removeItem('kmeansResult_video_' + videoIdGlobal);
      window.kmeansResult = null;
      if (window.classificationMode === 'db') loadInitialDbGroups();
    } else {
      alert('保存失敗: ' + (data.error || '不明'));
    }
  })
  .catch(function() { alert('通信エラーが発生しました'); });
}

// モード切り替え：ライン色を再描画
function switchClassificationMode(mode) {
  window.classificationMode = mode;
  localStorage.setItem('classificationMode_video_' + videoIdGlobal, mode);
  document.getElementById('visual-mode-controls').style.display = mode === 'visual' ? '' : 'none';
  document.getElementById('db-mode-controls').style.display    = mode === 'db'     ? '' : 'none';
  // フィルターパネルを切り替えてリセット
  var vf = document.getElementById('uc-visual-filter');
  var df = document.getElementById('uc-db-filter');
  if (vf) vf.style.display = mode === 'visual' ? '' : 'none';
  if (df) df.style.display = mode === 'db'     ? '' : 'none';
  if (mode === 'visual') { ucActiveGroupFilter = null; _applyUcVisualFilterButtons(); }
  else                   { ucActiveDbFilter    = null; _applyUcDbFilterButtons(); }
  if (!chartInstances.userClassification) return;

  const visualGroupColors = {
    groupA: 'rgba(13, 110, 253, 0.8)',
    groupB: 'rgba(40, 167, 69, 0.8)',
    groupC: 'rgba(255, 193, 7, 0.8)',
    groupD: 'rgba(220, 53, 69, 0.8)'
  };

  chartInstances.userClassification.data.datasets.forEach(function(dataset) {
    if (mode === 'db') {
      applyDbGroupColor(dataset, dataset.dbGroup || null);
    } else {
      // ビジュアル分類の色に戻す
      if (dataset.classification && visualGroupColors[dataset.classification]) {
        dataset.borderColor          = visualGroupColors[dataset.classification];
        dataset.borderWidth          = 3;
        dataset.pointBackgroundColor = visualGroupColors[dataset.classification];
        dataset.pointBorderColor     = visualGroupColors[dataset.classification];
        dataset.pointRadius          = 3;
      } else {
        dataset.borderColor          = 'rgba(128,128,128,0.3)';
        dataset.borderWidth          = 2;
        dataset.pointBackgroundColor = '#999';
        dataset.pointBorderColor     = '#999';
        dataset.pointRadius          = 2;
      }
    }
  });
  chartInstances.userClassification.update('none');

  // 統計エリアの切り替え
  var visualStats = document.getElementById('classificationStats');
  var dbStats     = document.getElementById('dbClassificationStats');
  if (mode === 'db') {
    if (visualStats) visualStats.style.display = 'none';
    if (dbStats)     dbStats.style.display = '';
    updateDbClassificationStats();
    updateDbFullStats();
  } else {
    if (visualStats) visualStats.style.display = '';
    if (dbStats)     dbStats.style.display = 'none';
    updateClassificationStats();
  }
}

// ===== グラフ表示フィルター =====

var ucActiveGroupFilter = null; // null=全表示, 'groupA'/'groupB'/'groupC'/'groupD'/'__unclassified__'
var ucActiveDbFilter    = null; // null=全表示, 'normal'/'fast_speed'/etc/'__unclassified__'

function _applyUcVisualFilterButtons() {
  var map = { null: 'ucVfAll', groupA: 'ucVfA', groupB: 'ucVfB', groupC: 'ucVfC', groupD: 'ucVfD', '__unclassified__': 'ucVfNull' };
  Object.values(map).forEach(function(id) {
    var btn = document.getElementById(id);
    if (!btn) return;
    btn.classList.remove('btn-secondary', 'btn-primary', 'btn-success', 'btn-warning', 'btn-danger');
    btn.classList.add('btn-outline-secondary', 'btn-outline-primary', 'btn-outline-success', 'btn-outline-warning', 'btn-outline-danger');
  });
  // active ボタンをソリッドに
  var activeKey = ucActiveGroupFilter === null ? 'null' : ucActiveGroupFilter;
  var styleMap = { 'null': ['btn-secondary','btn-outline-secondary'], groupA: ['btn-primary','btn-outline-primary'], groupB: ['btn-success','btn-outline-success'], groupC: ['btn-warning','btn-outline-warning'], groupD: ['btn-danger','btn-outline-danger'], '__unclassified__': ['btn-secondary','btn-outline-secondary'] };
  var activeId = map[activeKey];
  var activeBtn = document.getElementById(activeId);
  if (activeBtn && styleMap[activeKey]) {
    activeBtn.classList.remove(styleMap[activeKey][1]);
    activeBtn.classList.add(styleMap[activeKey][0]);
  }
}

function _applyUcDbFilterButtons() {
  var allIds = ['ucDfAll','ucDfNormal','ucDfFast','ucDfSkip','ucDfFastSkip','ucDfShort','ucDfLong','ucDfNull'];
  allIds.forEach(function(id) {
    var btn = document.getElementById(id);
    if (btn) { btn.style.fontWeight = 'normal'; btn.style.boxShadow = ''; }
  });
  var map = { null: 'ucDfAll', normal: 'ucDfNormal', fast_speed: 'ucDfFast', skip_heavy: 'ucDfSkip', fast_and_skip: 'ucDfFastSkip', too_short: 'ucDfShort', too_long: 'ucDfLong', '__unclassified__': 'ucDfNull' };
  var activeKey = ucActiveDbFilter === null ? 'null' : ucActiveDbFilter;
  var activeId = map[activeKey];
  var activeBtn = document.getElementById(activeId);
  if (activeBtn) { activeBtn.style.fontWeight = 'bold'; activeBtn.style.boxShadow = '0 0 0 2px currentColor'; }
  // ucDfAll: ソリッド/アウトライン切り替え
  var allBtn = document.getElementById('ucDfAll');
  if (allBtn) {
    allBtn.classList.toggle('btn-secondary', ucActiveDbFilter === null);
    allBtn.classList.toggle('btn-outline-secondary', ucActiveDbFilter !== null);
  }
}

function filterUcByGroup(group) {
  ucActiveGroupFilter = group;
  _applyUcVisualFilterButtons();
  if (!chartInstances.userClassification) return;
  chartInstances.userClassification.data.datasets.forEach(function(ds) {
    if (group === null) {
      ds.hidden = false;
    } else if (group === '__unclassified__') {
      ds.hidden = !!ds.classification;
    } else {
      ds.hidden = ds.classification !== group;
    }
  });
  chartInstances.userClassification.update('none');
}

function filterUcByDbGroup(group) {
  ucActiveDbFilter = group;
  _applyUcDbFilterButtons();
  if (!chartInstances.userClassification) return;
  chartInstances.userClassification.data.datasets.forEach(function(ds) {
    if (group === null) {
      ds.hidden = false;
    } else if (group === '__unclassified__') {
      ds.hidden = !!ds.dbGroup;
    } else {
      ds.hidden = ds.dbGroup !== group;
    }
  });
  chartInstances.userClassification.update('none');
}

// ===== 手動分類 =====

var sessionMetricsCache = null; // { session_id(number): { effective_speed, playing_speed, skip_coverage, duration_ratio } }

async function fetchSessionMetrics() {
  if (sessionMetricsCache) return sessionMetricsCache;
  var msg = document.getElementById('mc-msg');
  if (msg) msg.textContent = '指標データを取得中…';
  try {
    var url = '/videos/' + videoIdGlobal + '/management/session_metrics';
    var resp = await fetch(url);
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    var data = await resp.json();
    if (!data.ok) throw new Error(data.error || '不明');
    sessionMetricsCache = {};
    data.session_metrics.forEach(function(m) {
      // skip_coverage は % 表示用に100倍して保存
      sessionMetricsCache[m.session_id] = {
        effective_speed: m.effective_speed,
        playing_speed:   m.playing_speed,
        skip_coverage:   +(m.skip_coverage * 100).toFixed(2),
        duration_ratio:  m.duration_ratio
      };
    });
    if (msg) msg.textContent = '';
    return sessionMetricsCache;
  } catch(e) {
    if (msg) msg.textContent = '取得失敗: ' + e.message;
    return null;
  }
}

function getManualConditions() {
  var metrics = ['effective_speed', 'playing_speed', 'skip_coverage', 'duration_ratio'];
  return metrics.map(function(key) {
    var op  = document.getElementById('mcOp_'  + key).value;
    var val = parseFloat(document.getElementById('mcVal_' + key).value);
    return { key: key, op: op, val: val };
  }).filter(function(c) { return c.op !== 'none' && !isNaN(c.val); });
}

function matchesConditions(metrics, conditions) {
  return conditions.every(function(c) {
    var v = metrics[c.key];
    if (v == null) return false;
    if (c.op === 'gte') return v >= c.val;
    if (c.op === 'lte') return v <= c.val;
    return true;
  });
}

var _previewGen = 0; // 並行実行を防ぐ世代カウンタ

async function previewManualClassification() {
  var conditions = getManualConditions();
  var countEl = document.getElementById('mc-preview-count');
  if (conditions.length === 0) {
    if (countEl) countEl.textContent = '条件を1つ以上設定してください。';
    return;
  }

  var myGen = ++_previewGen; // この呼び出しの世代番号を記録

  var metrics = await fetchSessionMetrics();
  if (myGen !== _previewGen) return; // 後から呼ばれた実行があれば中止
  if (!metrics || !chartInstances.userClassification) return;

  var matched = 0, total = 0;
  chartInstances.userClassification.data.datasets.forEach(function(ds) {
    var m = metrics[ds.sessionId];
    total++;
    if (m && matchesConditions(m, conditions)) {
      matched++;
      ds.hidden           = false;
      ds._mc_highlight    = true;
      ds.borderColor          = '#22D3EE';
      ds.borderWidth          = 2;
      ds.pointBackgroundColor = '#22D3EE';
      ds.pointBorderColor     = '#22D3EE'; // 白ハロなし
      ds.pointBorderWidth     = 1;
      ds.pointRadius          = 5;
    } else {
      ds.hidden           = false;
      ds._mc_highlight    = false;
      ds.borderColor          = 'rgba(128,128,128,0.3)';
      ds.borderWidth          = 1;
      ds.pointBackgroundColor = '#999';
      ds.pointBorderColor     = '#999';
      ds.pointBorderWidth     = 1;
      ds.pointRadius          = 2;
    }
  });
  chartInstances.userClassification.update('none');
  if (countEl) countEl.textContent = '条件に合致: ' + matched + ' / ' + total + ' セッション';
}

function clearManualPreview() {
  if (!chartInstances.userClassification) return;
  _previewGen++; // 進行中のプレビュー非同期処理をキャンセル
  // 現在のモードに応じて色をリセット
  chartInstances.userClassification.data.datasets.forEach(function(ds) {
    ds.hidden = false;
    ds._mc_highlight = false;
  });
  if (window.classificationMode === 'db') {
    chartInstances.userClassification.data.datasets.forEach(function(ds) {
      ds.pointBorderWidth = 1;
      applyDbGroupColor(ds, ds.dbGroup || null);
    });
  } else {
    var groupColors = { groupA:'rgba(13,110,253,0.8)', groupB:'rgba(40,167,69,0.8)', groupC:'rgba(255,193,7,0.8)', groupD:'rgba(220,53,69,0.8)' };
    chartInstances.userClassification.data.datasets.forEach(function(ds) {
      ds.pointBorderWidth = 1;
      if (ds.classification && groupColors[ds.classification]) {
        ds.borderColor = groupColors[ds.classification];
        ds.pointBackgroundColor = groupColors[ds.classification];
        ds.pointBorderColor = groupColors[ds.classification];
        ds.borderWidth = 3; ds.pointRadius = 3;
      } else {
        ds.borderColor = 'rgba(128,128,128,0.3)';
        ds.pointBackgroundColor = '#999'; ds.pointBorderColor = '#999';
        ds.borderWidth = 2; ds.pointRadius = 2;
      }
    });
  }
  chartInstances.userClassification.update('none');
  var countEl = document.getElementById('mc-preview-count');
  if (countEl) countEl.textContent = '';
}

async function saveManualClassification() {
  var conditions = getManualConditions();
  var group = document.getElementById('mcTargetGroup').value;
  var msg   = document.getElementById('mc-msg');
  if (conditions.length === 0) { if (msg) msg.textContent = '条件を1つ以上設定してください。'; return; }
  if (!group)                   { if (msg) msg.textContent = 'グループを選択してください。'; return; }

  var metrics = await fetchSessionMetrics();
  if (!metrics) return;

  var assignments = {};
  Object.entries(metrics).forEach(function([sid, m]) {
    if (matchesConditions(m, conditions)) {
      assignments[parseInt(sid, 10)] = group;
    }
  });

  if (Object.keys(assignments).length === 0) {
    if (msg) msg.textContent = '条件に合致するセッションがありません。';
    return;
  }

  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
  var url = '<%= video_management_bulk_update_groups_path(video_id: @video) %>';
  if (msg) msg.textContent = '保存中…';
  fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
    body: JSON.stringify({ assignments: assignments })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.ok) {
      Object.assign(window.sessionGroupData, assignments);
      // DB グループ色を再適用
      loadInitialDbGroups();
      if (msg) msg.textContent = Object.keys(assignments).length + '件を「' + (SESSION_GROUP_LABELS_JS[group] || group) + '」に保存しました。';
      var countEl = document.getElementById('mc-preview-count');
      if (countEl) countEl.textContent = '';
      updateDbClassificationStats();
      updateDbFullStats();
    } else {
      if (msg) msg.textContent = '保存失敗: ' + (data.error || '不明');
    }
  })
  .catch(function() { if (msg) msg.textContent = '通信エラー。'; });
}

async function loadSessionMetricsIntoTable() {
  var btn = document.getElementById('loadMetricsBtn');
  if (btn) { btn.disabled = true; btn.textContent = '取得中…'; }

  var metrics = await fetchSessionMetrics();

  if (!metrics) {
    if (btn) { btn.disabled = false; btn.textContent = '📊 指標を表示'; }
    return;
  }

  // ヘッダー＋各セルを表示
  document.querySelectorAll('.metric-col').forEach(function(el) {
    el.style.display = '';
  });

  // 各行のセルに値を埋める
  document.querySelectorAll('.metric-effective-speed[data-sid]').forEach(function(td) {
    var sid = parseInt(td.dataset.sid, 10);
    var m   = metrics[sid];
    td.textContent = m ? m.effective_speed.toFixed(2) : '-';
  });
  document.querySelectorAll('.metric-playing-speed[data-sid]').forEach(function(td) {
    var sid = parseInt(td.dataset.sid, 10);
    var m   = metrics[sid];
    td.textContent = m ? m.playing_speed.toFixed(2) : '-';
  });
  document.querySelectorAll('.metric-skip-coverage[data-sid]').forEach(function(td) {
    var sid = parseInt(td.dataset.sid, 10);
    var m   = metrics[sid];
    td.textContent = m ? m.skip_coverage.toFixed(1) + '%' : '-';
  });
  document.querySelectorAll('.metric-duration-ratio[data-sid]').forEach(function(td) {
    var sid = parseInt(td.dataset.sid, 10);
    var m   = metrics[sid];
    td.textContent = m ? m.duration_ratio.toFixed(2) : '-';
  });

  if (btn) { btn.disabled = false; btn.textContent = '📊 指標を再取得'; }
}

function refreshUcChart() {
  var btn = document.getElementById('refreshUcChartBtn');
  if (btn) { btn.disabled = true; btn.textContent = '更新中…'; }
  var savedGroupFilter = ucActiveGroupFilter;
  var savedDbFilter    = ucActiveDbFilter;
  // 既存チャートを明示的に破棄してからポーリング開始（nullにしないと判定が競合する）
  if (chartInstances.userClassification) {
    try { chartInstances.userClassification.destroy(); } catch(e) {}
    chartInstances.userClassification = null;
  }
  window.scoreTimelineData = null;
  sessionMetricsCache = null; // 手動分類の指標キャッシュもクリア
  initializeUserClassificationChart();
  var pollCount = 0;
  var poll = setInterval(function() {
    pollCount++;
    if (chartInstances.userClassification || pollCount > 50) {
      clearInterval(poll);
      if (btn) { btn.disabled = false; btn.textContent = '↺ グラフを更新'; }
      if (!chartInstances.userClassification) return;
      if (window.classificationMode === 'db' && savedDbFilter !== null) {
        filterUcByDbGroup(savedDbFilter);
      } else if (window.classificationMode === 'visual' && savedGroupFilter !== null) {
        filterUcByGroup(savedGroupFilter);
      }
    }
  }, 200);
}

// ===== 既存ビジュアル分類リセット =====

// 分類結果をリセット
function resetUserClassification() {
  if (!confirm('分類をすべてリセットしていいですか？')) {
    return;
  }
  
  window.userClassifications = {
    groupA: [],
    groupB: [],
    groupC: [],
    groupD: []
  };
  
  const lineColor = 'rgba(128, 128, 128, 0.3)' ;
  
  chartInstances.userClassification.data.datasets.forEach(dataset => {
    dataset.classification = null;
    dataset.borderColor = lineColor;
    dataset.borderWidth = 2;
    dataset.pointBackgroundColor = '#999';
    dataset.pointBorderColor = '#999';
    dataset.pointRadius = 2;
  });
  
  chartInstances.userClassification.update('none');
  
  // ローカルストレージから分類データを削除
  const storageKey = `userClassification_video_${videoIdGlobal}`;
  localStorage.removeItem(storageKey);
  console.log('[ユーザー分類] ローカルストレージの分類データを削除');
  
  document.getElementById('classificationStats').innerHTML = '';
}

// DBに保存されたグループ分類をすべてリセット
async function resetAllDbGroups() {
  if (!confirm('DBに保存されたすべてのグループ分類をリセットします。\nこの操作は取り消せません。よろしいですか？')) return;

  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
  var url = '<%= video_management_reset_all_groups_path(video_id: @video) %>';
  try {
    var resp = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
    });
    var data = await resp.json();
    if (!data.ok) throw new Error(data.error || '不明');

    // sessionGroupData をクリア
    Object.keys(window.sessionGroupData).forEach(function(k) {
      delete window.sessionGroupData[k];
    });

    // グラフのデータセット色を未分類（グレー）に戻す
    if (chartInstances.userClassification) {
      chartInstances.userClassification.data.datasets.forEach(function(ds) {
        ds.dbGroup = null;
        if (window.classificationMode === 'db') {
          applyDbGroupColor(ds, null);
        }
      });
      chartInstances.userClassification.update('none');
    }

    updateDbClassificationStats();
    updateDbFullStats();
  } catch(e) {
    alert('リセットに失敗しました: ' + e.message);
  }
}

// 分類ごとの統計を計算・表示
function updateClassificationStats() {
  const responseData = window.responseData || [];
  
  // responseDataが存在しないか空の場合は処理をスキップ
  if (!responseData || responseData.length === 0) {
    console.warn('回答データが利用できません', responseData);
    return;
  }
  
  console.log('[分類統計] 全回答データ:', {
    総数: responseData.length,
    セッション数: [...new Set(responseData.map(r => r.session_id))].length,
    サンプル: responseData.slice(0, 3)
  });
  
  const statsContainer = document.getElementById('classificationStats');
  
  const groupLabels = {
    groupA: 'グループA',
    groupB: 'グループB',
    groupC: 'グループC',
    groupD: 'グループD'
  };
  
  const groupBgColors = {
    groupA: '#007bff',
    groupB: '#28a745',
    groupC: '#ffc107',
    groupD: '#dc3545'
  };
  
  // 全セッションIDを scoreTimelineData から収集（未分類計算用）
  const allSessionIds = new Set(
    (window.scoreTimelineData || []).map(s => s.session_id)
  );
  const classifiedSessionIds = new Set(
    Object.values(window.userClassifications).flat()
  );
  const unclassifiedSessionIds = [...allSessionIds].filter(id => !classifiedSessionIds.has(id));

  let html = '';

  Object.keys(window.userClassifications).forEach(group => {
    const sessionIds = window.userClassifications[group];
    
    if (sessionIds.length === 0) {
      html += `
        <div class="col-md-6 col-lg-3 mb-3">
          <div class="card" style="border-left: 4px solid ${groupBgColors[group]}">
            <div class="card-body">
              <h6 class="card-title">${groupLabels[group]}</h6>
              <p class="text-muted">分類なし</p>
            </div>
          </div>
        </div>
      `;
      return;
    }
    
    // このグループのセッションに関連する回答データを集計
    const groupResponses = responseData.filter(r => sessionIds.includes(r.session_id));
    
    console.log(`[分類統計] グループ ${group}:`, {
      セッション数: sessionIds.length,
      セッションIDs: sessionIds,
      型チェック: sessionIds.map(id => typeof id),
      該当回答数: groupResponses.length,
      回答の型チェック: responseData.slice(0, 1).map(r => ({ session_id: r.session_id, 型: typeof r.session_id })),
      詳細フィルタ: responseData.map(r => ({
        session_id: r.session_id,
        マッチ: sessionIds.includes(r.session_id),
        sessionIdsに含: sessionIds.includes(r.session_id)
      }))
    });
    
    // ユーザー数ベースでカウントするかの確認
    const useUniqueUsers = document.getElementById('countUniqueUsersToggle').checked;
    let groupMemberCount;
    let displayLabel;
    let uniqueUserIds;  // スコープ外で参照できるように宣言
    
    if (useUniqueUsers) {
      // ユーザー数でカウント：セッションIDからユーザーIDを抽出してユニークカウント
      uniqueUserIds = new Set(
        sessionIds.map(sessionId => window.sessionUserMap[sessionId]?.user_id).filter(uid => uid !== undefined)
      );
      groupMemberCount = uniqueUserIds.size;
      displayLabel = `${groupMemberCount}名（ユーザー数）`;
    } else {
      // セッション数でカウント（デフォルト）
      groupMemberCount = sessionIds.length;
      displayLabel = `${groupMemberCount}件（セッション数）`;
      uniqueUserIds = null;
    }
    
    if (groupResponses.length === 0) {
      html += `
        <div class="col-md-6 col-lg-3 mb-3">
          <div class="card" style="border-left: 4px solid ${groupBgColors[group]}">
            <div class="card-body">
              <h6 class="card-title">${groupLabels[group]}</h6>
              <p class="text-muted">グループ人数: ${displayLabel}</p>
              <p class="text-muted">回答なし</p>
            </div>
          </div>
        </div>
      `;
      return;
    }
    
    // 統計計算
    const totalResponses = groupResponses.length;
    const correctResponses = groupResponses.filter(r => r.correct).length;
    const correctRate = ((correctResponses / totalResponses) * 100).toFixed(1);
    const avgResponseTime = (groupResponses.reduce((sum, r) => sum + (r.response_time || 0), 0) / totalResponses / 1000).toFixed(1);
    
    // 平均回答数の計算：ユーザー数またはセッション数でカウント
    const divisor = groupMemberCount;
    const avgResponsesPerSession = (totalResponses / divisor).toFixed(1);
    const unitLabel = useUniqueUsers ? '回/ユーザー' : '回/セッション';
    
    // 新規項目の計算
    const totalQuestions = window.totalQuestions || 0;
    
    // デバッグログ
    console.log(`[分類統計] グループ ${group} 計算詳細:`, {
      正答数: correctResponses,
      回答数: totalResponses,
      問題数: totalQuestions,
      グループ人数: groupMemberCount,
      カウント方式: useUniqueUsers ? 'ユーザー数' : 'セッション数',
      正答フィルタ確認: groupResponses.slice(0, 3).map(r => ({ correct: r.correct, is_correct: r.is_correct }))
    });
    
    // 全問正答率 = 各セッションで得られた全ての回答をベースに計算
    // = (グループ全体の正答数 ÷ グループが有すべき最大正答数) × 100%
    // グループが有すべき最大正答数 = 問題数 × グループ人数
    const overallAccuracyRate = totalQuestions > 0 && groupMemberCount > 0
      ? ((correctResponses / (totalQuestions * groupMemberCount)) * 100).toFixed(1)
      : 0;
    
    console.log(`[分類統計] グループ ${group} 計算結果:`, {
      '正答率（回答ベース）': correctRate + '%',
      '全問正答率': overallAccuracyRate + '%',
      '計算式詳細': {
        '全問正答率': `${correctResponses} / (${totalQuestions} × ${groupMemberCount}) × 100 = ${overallAccuracyRate}%`
      }
    });
    
    html += `
      <div class="col-md-6 col-lg-3 mb-3">
        <div class="card" style="border-left: 4px solid ${groupBgColors[group]}">
          <div class="card-body">
            <h6 class="card-title">${groupLabels[group]}</h6>
            <dl class="small mb-0">
              <dt>グループ人数</dt>
              <dd>${displayLabel}</dd>
              <dt>回答数</dt>
              <dd>${totalResponses}件</dd>
              <dt>平均回答数</dt>
              <dd><strong>${avgResponsesPerSession}${unitLabel}</strong></dd>
              <dt>正答数</dt>
              <dd>${correctResponses}件</dd>
              <dt>正答率</dt>
              <dd><strong style="color: ${groupBgColors[group]}">${correctRate}%</strong></dd>
              <dt>全問正答率</dt>
              <dd><strong style="color: ${groupBgColors[group]}">${overallAccuracyRate}%</strong></dd>
              <dt>平均回答時間</dt>
              <dd>${avgResponseTime}秒</dd>
            </dl>
          </div>
        </div>
      </div>
    `;
  });
  
  // 未分類カード
  {
    const sessionIds = unclassifiedSessionIds;
    const useUniqueUsers = document.getElementById('countUniqueUsersToggle').checked;
    let memberCount, displayLabel;
    if (useUniqueUsers) {
      const uids = new Set(sessionIds.map(id => window.sessionUserMap[id]?.user_id).filter(Boolean));
      memberCount  = uids.size;
      displayLabel = `${memberCount}名（ユーザー数）`;
    } else {
      memberCount  = sessionIds.length;
      displayLabel = `${memberCount}件（セッション数）`;
    }
    const groupResponses = responseData.filter(r => sessionIds.includes(r.session_id));
    let cardBody;
    if (groupResponses.length === 0) {
      cardBody = `<p class="text-muted small mb-0">セッション: ${displayLabel}<br>回答なし</p>`;
    } else {
      const total       = groupResponses.length;
      const correct     = groupResponses.filter(r => r.correct).length;
      const correctRate = ((correct / total) * 100).toFixed(1);
      const avgTime     = (groupResponses.reduce((s, r) => s + (r.response_time || 0), 0) / total / 1000).toFixed(1);
      const avgPer      = memberCount > 0 ? (total / memberCount).toFixed(1) : '-';
      const unitLabel   = useUniqueUsers ? '回/ユーザー' : '回/セッション';
      const totalQ      = window.totalQuestions || 0;
      const overallRate = totalQ > 0 && memberCount > 0 ? ((correct / (totalQ * memberCount)) * 100).toFixed(1) : '-';
      cardBody = `<dl class="small mb-0">
        <dt>グループ人数</dt><dd>${displayLabel}</dd>
        <dt>回答数</dt><dd>${total}件</dd>
        <dt>平均回答数</dt><dd><strong>${avgPer}${unitLabel}</strong></dd>
        <dt>正答数</dt><dd>${correct}件</dd>
        <dt>正答率</dt><dd><strong>${correctRate}%</strong></dd>
        <dt>全問正答率</dt><dd><strong>${overallRate}%</strong></dd>
        <dt>平均回答時間</dt><dd>${avgTime}秒</dd>
      </dl>`;
    }
    html += `
      <div class="col-md-6 col-lg-3 mb-3">
        <div class="card h-100" style="border-left: 4px solid #6c757d">
          <div class="card-body">
            <h6 class="card-title text-muted">未分類</h6>
            ${cardBody}
          </div>
        </div>
      </div>`;
  }

  statsContainer.innerHTML = html || '<p class="text-muted">分類したユーザーがありません</p>';
}

// Tab切り替え時に初期化
document.addEventListener('shown.bs.tab', function(e) {
  if (e.target.id === 'user-classification-tab') {
    initializeUserClassificationChart();
